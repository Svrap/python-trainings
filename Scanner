# ============================================================
# ARIS Phase 1 - Project Scanner
# Connects to Dataiku and builds the knowledge base.
#
# RUN FROM PROJECT ROOT:
#   python phase1_scanner\scanner.py
#
# OUTPUTS (in outputs\ folder):
#   {PREFIX}PROJECT_GRAPH.json
#   {PREFIX}RECIPE_INTELLIGENCE.json
#   {PREFIX}DATASET_REGISTRY.json
#   {PREFIX}SUMMARY.json
# ============================================================

import dataikuapi
import json
import os
import sys
import urllib3

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

sys.path.append(os.path.join(os.path.dirname(__file__), '..'))

from config.aris_config import (
    DATAIKU_URL, DATAIKU_API_KEY, PROJECT_KEY,
    LOCAL_OUTPUT_DIR, STALE_AFTER_DAYS,
    PROJECT_GRAPH_FILE, RECIPE_INTELLIGENCE_FILE,
    DATASET_REGISTRY_FILE, SUMMARY_FILE,
    OUTPUT_PREFIX, output_path
)
from datetime import datetime


def save(filename, data):
    path = output_path(filename)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, default=str)


def run_phase1():

    print("=" * 70)
    print(f"ARIS v1.0 | Phase 1 - Project Scanner")
    print(f"Project : {PROJECT_KEY}")
    print(f"Started : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 70)

    os.makedirs(LOCAL_OUTPUT_DIR, exist_ok=True)

    # Connect
    try:
        client = dataikuapi.DSSClient(DATAIKU_URL, DATAIKU_API_KEY)
        client._session.verify = False
        project = client.get_project(PROJECT_KEY)
        print("[OK] Connected to Dataiku")
    except Exception as e:
        print(f"[ERROR] Cannot connect: {e}")
        return

    ARIS_METADATA = {
        "aris_version":    "1.0",
        "phase":           "Phase 1 - Project Scanner",
        "project":         PROJECT_KEY,
        "generated_at":    datetime.now().isoformat(timespec="seconds"),
        "stale_after_days": STALE_AFTER_DAYS
    }

    project_scan = {**ARIS_METADATA, "recipes": [], "datasets": [], "edges": []}
    recipe_intelligence = {**ARIS_METADATA, "recipes": []}
    dataset_registry = {**ARIS_METADATA, "datasets": {}}

    recipe_success = recipe_errors = 0
    dataset_success = dataset_errors = 0

    # ----------------------------------------------------------
    # SCAN RECIPES
    # ----------------------------------------------------------
    try:
        recipes = project.list_recipes()
    except Exception as e:
        print(f"[ERROR] Cannot list recipes: {e}")
        return

    total = len(recipes)
    print(f"\nScanning {total} recipes...")

    for index, recipe_item in enumerate(recipes):

        try:
            name  = recipe_item.get("name", "") if isinstance(recipe_item, dict) else str(recipe_item)
            rtype = recipe_item.get("type", "unknown") if isinstance(recipe_item, dict) else "unknown"
        except Exception:
            name  = str(recipe_item)
            rtype = "unknown"

        print(f"  [{index+1:>3}/{total}] {name[:60]:<60}", end="\r")
        project_scan["recipes"].append({"name": name, "type": rtype})

        inputs = []
        outputs = []
        payload = None
        json_payload = None
        generated_sql = None
        joins = []
        params = {}
        raw_definition = {}

        try:
            recipe_obj = project.get_recipe(name)
            settings   = recipe_obj.get_settings()

            # Inputs
            try:
                for role, val in settings.get_recipe_inputs().items():
                    items = val if isinstance(val, list) else val.get("items", [])
                    for item in items:
                        ds = item.get("ref") if isinstance(item, dict) else str(item)
                        if ds:
                            inputs.append(ds)
                            project_scan["edges"].append({
                                "source": ds, "target": name, "relationship": "INPUT"
                            })
            except Exception:
                pass

            # Outputs
            try:
                for role, val in settings.get_recipe_outputs().items():
                    items = val if isinstance(val, list) else val.get("items", [])
                    for item in items:
                        ds = item.get("ref") if isinstance(item, dict) else str(item)
                        if ds:
                            outputs.append(ds)
                            project_scan["edges"].append({
                                "source": name, "target": ds, "relationship": "OUTPUT"
                            })
            except Exception:
                pass

            # Raw definition
            try:
                raw_definition = settings.get_recipe_raw_definition()
            except Exception:
                pass

            # Params
            try:
                params = settings.get_recipe_params()
            except Exception:
                pass

            # Payload — code for SQL/Python, JSON for visual recipes
            if rtype in ("python", "pyspark", "r",
                         "sql_query", "sql_script", "hive", "spark_sql"):
                try:
                    payload = settings.get_payload()
                except Exception:
                    pass
                if not payload:
                    try:
                        payload = settings.get_code()
                    except Exception:
                        pass
            else:
                # Visual recipes: join, grouping, window, prepare etc.
                try:
                    json_payload = settings.get_json_payload()
                except Exception:
                    pass

            # Join keys — from raw_joins
            try:
                if hasattr(settings, "raw_joins"):
                    joins = settings.raw_joins or []
            except Exception:
                pass

            # Generated SQL — works for join, group, window on SQL engine
            # Confirmed from Dataiku community support
            try:
                status = recipe_obj.get_status()
                if hasattr(status, "data") and isinstance(status.data, dict):
                    if "sql" in status.data:
                        generated_sql = status.data["sql"]
            except Exception:
                pass

            recipe_success += 1

        except Exception as e:
            recipe_errors += 1

        recipe_intelligence["recipes"].append({
            "recipe_name":    name,
            "recipe_type":    rtype,
            "inputs":         inputs,
            "outputs":        outputs,
            "params":         params,
            "joins":          joins,
            "payload":        payload,
            "json_payload":   json_payload,
            "generated_sql":  generated_sql,
            "raw_definition": raw_definition,
            "code":           payload if rtype in ("python", "pyspark", "r") else None
        })

    print(f"\n[OK] Recipes: {recipe_success} scanned, {recipe_errors} errors")

    # ----------------------------------------------------------
    # SCAN DATASETS
    # ----------------------------------------------------------
    try:
        datasets = project.list_datasets()
    except Exception as e:
        print(f"[ERROR] Cannot list datasets: {e}")
        return

    total_ds = len(datasets)
    print(f"\nScanning {total_ds} datasets...")

    for index, ds_item in enumerate(datasets):

        try:
            name = ds_item.get("name", "") if isinstance(ds_item, dict) else str(ds_item)
        except Exception:
            name = str(ds_item)

        print(f"  [{index+1:>3}/{total_ds}] {name[:60]:<60}", end="\r")
        project_scan["datasets"].append({"name": name})

        try:
            dataset_obj = project.get_dataset(name)

            schema = {}
            columns = []
            column_details = []

            try:
                schema = dataset_obj.get_schema()
                for col in schema.get("columns", []):
                    col_name = col.get("name")
                    col_type = col.get("type", "string")
                    if col_name:
                        columns.append(col_name)
                        column_details.append({"name": col_name, "type": col_type})
            except Exception:
                pass

            connection = db_schema = table = None
            try:
                raw = dataset_obj.get_settings().get_raw()
                p   = raw.get("params", {})
                connection = p.get("connection")
                db_schema  = p.get("schema")
                table      = p.get("table")
            except Exception:
                pass

            dataset_registry["datasets"][name] = {
                "name":           name,
                "connection":     connection,
                "schema":         db_schema,
                "table":          table,
                "column_count":   len(columns),
                "columns":        columns,
                "column_details": column_details,
                "full_schema":    schema
            }
            dataset_success += 1

        except Exception as e:
            dataset_registry["datasets"][name] = {
                "name": name, "error": str(e),
                "columns": [], "column_details": [], "column_count": 0
            }
            dataset_errors += 1

    print(f"\n[OK] Datasets: {dataset_success} scanned, {dataset_errors} errors")

    # ----------------------------------------------------------
    # SUMMARY AND SAVE
    # ----------------------------------------------------------
    recipe_type_counter = {}
    for r in recipe_intelligence["recipes"]:
        t = r.get("recipe_type", "unknown")
        recipe_type_counter[t] = recipe_type_counter.get(t, 0) + 1

    summary = {
        **ARIS_METADATA,
        "execution": {
            "recipes_scanned":       recipe_success,
            "recipes_with_errors":   recipe_errors,
            "datasets_scanned":      dataset_success,
            "datasets_with_errors":  dataset_errors,
            "edges_captured":        len(project_scan["edges"]),
            "recipe_type_breakdown": recipe_type_counter
        },
        "output_files": [
            PROJECT_GRAPH_FILE, RECIPE_INTELLIGENCE_FILE,
            DATASET_REGISTRY_FILE, SUMMARY_FILE
        ]
    }

    print("\nSaving outputs...")
    save(PROJECT_GRAPH_FILE,       project_scan)
    save(RECIPE_INTELLIGENCE_FILE, recipe_intelligence)
    save(DATASET_REGISTRY_FILE,    dataset_registry)
    save(SUMMARY_FILE,             summary)

    # ----------------------------------------------------------
    # FINAL REPORT
    # ----------------------------------------------------------
    print("\n" + "=" * 70)
    print("ARIS Phase 1 Complete")
    print("=" * 70)
    print(f"Project          : {PROJECT_KEY}")
    print(f"Completed        : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"Recipes scanned  : {recipe_success}  |  Errors: {recipe_errors}")
    print(f"Datasets scanned : {dataset_success}  |  Errors: {dataset_errors}")
    print(f"Edges captured   : {len(project_scan['edges'])}")
    print()
    print("Recipe types:")
    for rtype, count in sorted(recipe_type_counter.items()):
        print(f"  {rtype:<20} : {count}")
    print()
    print(f"Outputs saved to : {LOCAL_OUTPUT_DIR}\\")
    print("Next             : python phase3_transformation\\transformation.py")
    print("=" * 70)


if __name__ == "__main__":
    run_phase1()
