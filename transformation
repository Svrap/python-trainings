# ============================================================
# HELPERS
# ============================================================

def load_json(filename):
    path = output_path(filename)
    if not os.path.exists(path):
        raise FileNotFoundError(f"Not found: {path}\nRun Phase 1 first.")
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def save_json(filename, data):
    with open(output_path(filename), "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, default=str)
    print(f"  [SAVED] {filename}")

def save_text(filename, text):
    with open(output_path(filename), "w", encoding="utf-8") as f:
        f.write(text)
    print(f"  [SAVED] {filename}")

def add_to_index(index, col, recipe_name, recipe_type, behavior):
    if not col:
        return
    if col not in index:
        index[col] = []
    index[col].append({"recipe": recipe_name, "type": recipe_type, "behavior": behavior})

# ============================================================
# SQL ANALYSER
# ============================================================

RESERVED = {
    "SELECT", "FROM", "WHERE", "AND", "OR", "NOT", "AS", "ON",
    "JOIN", "LEFT", "RIGHT", "INNER", "OUTER", "FULL", "CROSS",
    "GROUP", "BY", "ORDER", "HAVING", "LIMIT", "UNION", "ALL",
    "CASE", "WHEN", "THEN", "ELSE", "END", "IN", "IS", "NULL",
    "LIKE", "BETWEEN", "EXISTS", "DISTINCT", "WITH", "TOP",
    "INSERT", "UPDATE", "DELETE", "CREATE", "DROP", "ALTER",
    "TRUE", "FALSE", "ASC", "DESC", "INTO", "VALUES", "SET"
}

def analyse_sql(sql_text):
    if not sql_text:
        return {}

    u = sql_text.upper()
    result = {
        "select_columns": [], "where_columns": [],
        "join_columns": [], "group_columns": [],
        "case_columns": [], "aggregate_columns": []
    }

    # Aggregations
    for m in re.finditer(
        r'(SUM|COUNT|AVG|MIN|MAX|COUNT_DISTINCT|MEDIAN|STDDEV)\s*\(\s*(?:DISTINCT\s+)?([^)]+?)\s*\)',
        u
    ):
        col = m.group(2).strip().strip('"\'`')
        if col and col not in RESERVED and col != "*":
            result["aggregate_columns"].append({"column": col, "function": m.group(1)})

    # CASE WHEN
    for m in re.finditer(r'CASE\s+WHEN\s+"?([A-Z_][A-Z0-9_]*)"?', u):
        if m.group(1) not in RESERVED:
            result["case_columns"].append(m.group(1))

    # SELECT
    sm = re.search(r'SELECT\s+(.*?)\s+FROM\s', u, re.DOTALL)
    if sm:
        st = sm.group(1)
        for m in re.finditer(r'"?([A-Z_][A-Z0-9_.]*)"?\s+AS\s+"?([A-Z_][A-Z0-9_]*)"?', st):
            src, alias = m.group(1).strip('"\''), m.group(2)
            if alias not in RESERVED and src not in RESERVED:
                result["select_columns"].append({
                    "source": src, "alias": alias,
                    "transformed": src.upper() != alias.upper()
                })
        for m in re.finditer(r'"([A-Z_][A-Z0-9_]*)"', st):
            col = m.group(1)
            if col not in RESERVED and not any(
                c.get("source") == col or c.get("alias") == col
                for c in result["select_columns"]
            ):
                result["select_columns"].append({"source": col, "alias": col, "transformed": False})

    # WHERE
    wm = re.search(r'\bWHERE\b(.*?)(?:\bGROUP\s+BY\b|\bORDER\s+BY\b|\bHAVING\b|$)', u, re.DOTALL)
    if wm:
        for m in re.finditer(
            r'"?([A-Z_][A-Z0-9_]*)"?\s*(?:=|!=|<>|>=|<=|>|<|\bIS\b|\bIN\b|\bLIKE\b)',
            wm.group(1)
        ):
            if m.group(1) not in RESERVED:
                result["where_columns"].append(m.group(1))

    # GROUP BY
    gm = re.search(r'\bGROUP\s+BY\b(.*?)(?:\bHAVING\b|\bORDER\s+BY\b|$)', u, re.DOTALL)
    if gm:
        for m in re.finditer(r'"?([A-Z_][A-Z0-9_]*)"?', gm.group(1)):
            if m.group(1) not in RESERVED:
                result["group_columns"].append(m.group(1))

    # JOIN ON
    for m in re.finditer(
        r'\bON\b\s+"?([A-Z_][A-Z0-9_.]*)"?\s*=\s*"?([A-Z_][A-Z0-9_.]*)"?', u
    ):
        left  = m.group(1).split(".")[-1]
        right = m.group(2).split(".")[-1]
        if left  not in RESERVED: result["join_columns"].append(left)
        if right not in RESERVED: result["join_columns"].append(right)

    return result

# ============================================================
# JOIN RECIPE ANALYSER
# Reads from recipe["joins"] and recipe["json_payload"]
# Structure confirmed from Dataiku API source code.
# ============================================================

def analyse_join(recipe):
    result = {
        "join_type":        "unknown",
        "join_keys":        [],
        "left_input":       (recipe.get("inputs") or [None])[0],
        "right_inputs":     (recipe.get("inputs") or [])[1:],
        "selected_columns": []
    }

    # From joins array
    for join in (recipe.get("joins") or []):
        if not isinstance(join, dict):
            continue
        if join.get("type"):
            result["join_type"] = join["type"]
        for cond in join.get("on", []):
            if not isinstance(cond, dict):
                continue
            col1 = cond.get("column1", {})
            col2 = cond.get("column2", {})
            left  = col1.get("name", "") if isinstance(col1, dict) else str(col1)
            right = col2.get("name", "") if isinstance(col2, dict) else str(col2)
            if left or right:
                result["join_keys"].append({
                    "left": left, "right": right,
                    "condition": cond.get("type", "EQ")
                })

    # From json_payload
    payload = recipe.get("json_payload") or {}
    if isinstance(payload, dict):
        if result["join_type"] == "unknown":
            result["join_type"] = payload.get("joinType", "unknown")
        if not result["join_keys"]:
            for join in payload.get("joins", []):
                if not isinstance(join, dict):
                    continue
                for cond in join.get("on", []):
                    if not isinstance(cond, dict):
                        continue
                    col1 = cond.get("column1", {})
                    col2 = cond.get("column2", {})
                    result["join_keys"].append({
                        "left":  col1.get("name", "") if isinstance(col1, dict) else "",
                        "right": col2.get("name", "") if isinstance(col2, dict) else "",
                        "condition": "EQ"
                    })
        for col in payload.get("selectedColumns", []):
            if isinstance(col, dict) and col.get("name"):
                result["selected_columns"].append({
                    "name":  col["name"],
                    "table": col.get("tableReference", {}).get("table", "")
                })

    return result

# ============================================================
# PYTHON / PYSPARK ANALYSER
# ============================================================

def analyse_python(code_text):
    if not code_text:
        return {"columns_referenced": [], "operations": []}

    result = {"columns_referenced": [], "operations": []}

    for pattern in [
        r'df\s*\[["\'`]([^"\'`]+)["\'`]\]',
        r'\.(?:select|filter|withColumn|groupBy|orderBy|sort|drop)\s*\(\s*["\'`]([^"\'`]+)["\'`]',
        r'\b(?:col|F\.col)\s*\(\s*["\'`]([^"\'`]+)["\'`]\)',
    ]:
        for m in re.finditer(pattern, code_text, re.IGNORECASE):
            col = m.group(1).strip()
            if col and col not in result["columns_referenced"]:
                result["columns_referenced"].append(col)

    for pattern, op in [
        (r'\.groupBy\s*\(',    "GROUP_BY"),
        (r'\.agg\s*\(',        "AGGREGATION"),
        (r'\.join\s*\(',       "JOIN"),
        (r'\.filter\s*\(',     "FILTER"),
        (r'\.withColumn\s*\(', "TRANSFORM"),
        (r'\.select\s*\(',     "SELECT"),
        (r'\.drop\s*\(',       "DROP"),
        (r'\.distinct\s*\(',   "DISTINCT"),
        (r'\.union\s*\(',      "UNION"),
    ]:
        if re.search(pattern, code_text, re.IGNORECASE):
            if op not in result["operations"]:
                result["operations"].append(op)

    return result

# ============================================================
# GROUP RECIPE ANALYSER
# json_payload has "keys" and "values" - confirmed from Dataiku docs
# ============================================================

def analyse_group(recipe):
    result = {"group_keys": [], "aggregations": [], "all_columns": []}
    payload = recipe.get("json_payload") or {}
    if not isinstance(payload, dict):
        return result

    for key in payload.get("keys", []):
        if isinstance(key, dict) and key.get("column"):
            result["group_keys"].append(key["column"])
            result["all_columns"].append(key["column"])

    for val in payload.get("values", []):
        if isinstance(val, dict) and val.get("column"):
            col  = val["column"]
            aggs = [a.upper() for a in
                    ["sum","count","avg","min","max","stddev",
                     "count_distinct","first","last"]
                    if val.get(a)]
            result["aggregations"].append({"column": col, "aggregations": aggs})
            result["all_columns"].append(col)

    return result

# ============================================================
# WINDOW RECIPE ANALYSER
# Confirmed from Dataiku WindowRecipeSettings docs
# ============================================================

def analyse_window(recipe):
    result = {"partition_by": [], "order_by": [], "window_columns": [], "all_columns": []}
    payload = recipe.get("json_payload") or {}
    if not isinstance(payload, dict):
        return result

    win = payload.get("windowDefinitions", {})
    if isinstance(win, dict):
        for col in win.get("partitioning", []):
            if isinstance(col, dict) and col.get("column"):
                result["partition_by"].append(col["column"])
                result["all_columns"].append(col["column"])
        for col in win.get("ordering", []):
            if isinstance(col, dict) and col.get("column"):
                result["order_by"].append(col["column"])
                result["all_columns"].append(col["column"])

    for col in payload.get("computedColumns", []):
        if isinstance(col, dict) and col.get("name"):
            result["window_columns"].append({"name": col["name"], "mode": col.get("mode", "")})
            result["all_columns"].append(col["name"])

    return result

# ============================================================
# MAIN
# ============================================================

def run_phase3():

    print("=" * 70)
    print(f"ARIS v1.0 | Phase 3 - Code Intelligence")
    print(f"Project : {PROJECT_KEY}")
    print(f"Started : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 70)

    recipe_data  = load_json(RECIPE_INTELLIGENCE_FILE)
    dataset_data = load_json(DATASET_REGISTRY_FILE)

    # Staleness check
    try:
        age = (datetime.now() - datetime.fromisoformat(
            recipe_data.get("generated_at", "2000-01-01")
        )).days
        if age > STALE_AFTER_DAYS:
            print(f"[WARNING] Context is {age} days old. Consider re-running Phase 1.")
    except Exception:
        pass

    recipes  = recipe_data.get("recipes", [])
    datasets = dataset_data.get("datasets", {})
    print(f"[OK] Loaded {len(recipes)} recipes | {len(datasets)} datasets\n")

    recipe_analyses = []
    column_index    = {}
    success = errors = 0

    print(f"Analysing {len(recipes)} recipes...")

    for index, recipe in enumerate(recipes):

        name    = recipe.get("recipe_name", "")
        rtype   = recipe.get("recipe_type", "unknown")
        inputs  = recipe.get("inputs",  [])
        outputs = recipe.get("outputs", [])
        payload = recipe.get("payload", "") or ""
        code    = recipe.get("code",    "") or ""
        gen_sql = recipe.get("generated_sql", "") or ""

        print(f"  [{index+1:>3}/{len(recipes)}] {name[:60]:<60}", end="\r")

        a = {
            "recipe_name":          name,
            "recipe_type":          rtype,
            "inputs":               inputs,
            "outputs":              outputs,
            "code_present":         bool(payload or code or gen_sql),
            "sql_analysis":         {},
            "join_analysis":        {},
            "python_analysis":      {},
            "group_analysis":       {},
            "window_analysis":      {},
            "columns_by_behavior":  {},
            "all_columns":          [],
            "recipe_summary":       ""
        }

        # ----------------------------------------------------------
        # SQL
        # ----------------------------------------------------------
        if rtype in ("sql_query", "sql_script", "hive", "spark_sql"):

            sql_text = payload or gen_sql
            if sql_text:
                try:
                    sa = analyse_sql(sql_text)
                    a["sql_analysis"] = sa

                    behaviors = {}
                    all_cols  = set()

                    for ce in sa.get("select_columns", []):
                        key = ce.get("alias") or ce.get("source", "")
                        all_cols.add(key)
                        behaviors[key] = "TRANSFORMED" if ce.get("transformed") else "PASSTHROUGH"

                    for agg in sa.get("aggregate_columns", []):
                        behaviors[agg["column"]] = "AGGREGATED"
                        all_cols.add(agg["column"])

                    for col in sa.get("case_columns", []):
                        behaviors[col] = "CALCULATED"
                        all_cols.add(col)

                    for col in sa.get("join_columns", []):
                        if col not in behaviors:
                            behaviors[col] = "JOIN_KEY"
                        all_cols.add(col)

                    for col in sa.get("group_columns", []):
                        if col not in behaviors:
                            behaviors[col] = "GROUPED"
                        all_cols.add(col)

                    for col in sa.get("where_columns", []):
                        if col not in behaviors:
                            behaviors[col] = "FILTER_RULE"
                        all_cols.add(col)

                    a["columns_by_behavior"] = behaviors
                    a["all_columns"]         = list(all_cols)

                    sc = len(sa.get("select_columns", []))
                    wc = len(sa.get("where_columns",  []))
                    ac = len(sa.get("aggregate_columns", []))

                    a["recipe_summary"] = (
                        f"SQL recipe. {sc} SELECT columns"
                        + (f", {wc} WHERE filters" if wc else "")
                        + (f", {ac} aggregations" if ac else "")
                        + f". Reads: {', '.join(inputs[:2])}."
                    )

                    for col, beh in behaviors.items():
                        add_to_index(column_index, col, name, rtype, beh)

                    success += 1

                except Exception as e:
                    a["error"] = str(e)
                    errors += 1
            else:
                a["recipe_summary"] = "SQL recipe - no payload captured. Re-run Phase 1."
                a["warning"] = "No SQL available"

        # ----------------------------------------------------------
        # JOIN
        # ----------------------------------------------------------
        elif rtype == "join":
            try:
                ja = analyse_join(recipe)
                a["join_analysis"] = ja

                all_cols = set()

                for jk in ja.get("join_keys", []):
                    for side in ("left", "right"):
                        col = jk.get(side, "")
                        if col:
                            all_cols.add(col)
                            a["columns_by_behavior"][col] = "JOIN_KEY"
                            add_to_index(column_index, col, name, rtype, "JOIN_KEY")

                for ci in ja.get("selected_columns", []):
                    col = ci.get("name", "")
                    if col and col not in a["columns_by_behavior"]:
                        all_cols.add(col)
                        a["columns_by_behavior"][col] = "PASSTHROUGH"
                        add_to_index(column_index, col, name, rtype, "PASSTHROUGH")

                # Also analyse generated SQL if available
                if gen_sql:
                    sa = analyse_sql(gen_sql)
                    a["sql_analysis"] = sa

                a["all_columns"] = list(all_cols)
                a["recipe_summary"] = (
                    f"Join recipe ({ja.get('join_type','unknown')}). "
                    f"{len(ja.get('join_keys',[]))} join keys. "
                    f"Left: {ja.get('left_input','')}."
                )
                success += 1

            except Exception as e:
                a["error"] = str(e)
                errors += 1

        # ----------------------------------------------------------
        # PYTHON / PYSPARK / R
        # ----------------------------------------------------------
        elif rtype in ("python", "pyspark", "r"):
            code_text = code or payload
            if code_text:
                try:
                    pa = analyse_python(code_text)
                    a["python_analysis"] = pa

                    all_cols = set(pa.get("columns_referenced", []))
                    a["all_columns"] = list(all_cols)

                    for col in all_cols:
                        a["columns_by_behavior"][col] = "REFERENCED"
                        add_to_index(column_index, col, name, rtype, "REFERENCED")

                    ops = pa.get("operations", [])
                    a["recipe_summary"] = (
                        f"Python recipe. "
                        f"Operations: {', '.join(ops) if ops else 'none found'}. "
                        f"{len(all_cols)} columns referenced."
                    )
                    success += 1

                except Exception as e:
                    a["error"] = str(e)
                    errors += 1
            else:
                a["recipe_summary"] = "Python recipe - no code captured. Re-run Phase 1."
                a["warning"] = "No code available"

        # ----------------------------------------------------------
        # GROUP / AGGREGATION
        # ----------------------------------------------------------
        elif rtype in ("grouping", "group"):
            try:
                ga = analyse_group(recipe)
                a["group_analysis"] = ga

                for col in ga.get("group_keys", []):
                    a["columns_by_behavior"][col] = "GROUPED"
                    add_to_index(column_index, col, name, rtype, "GROUPED")

                for agg in ga.get("aggregations", []):
                    col = agg["column"]
                    a["columns_by_behavior"][col] = "AGGREGATED"
                    add_to_index(column_index, col, name, rtype, "AGGREGATED")

                # Also analyse generated SQL if available
                if gen_sql:
                    a["sql_analysis"] = analyse_sql(gen_sql)

                a["all_columns"] = ga.get("all_columns", [])
                keys = ga.get("group_keys", [])
                aggs = ga.get("aggregations", [])
                a["recipe_summary"] = (
                    f"Group recipe. Group by: {', '.join(keys[:3]) or 'none'}. "
                    f"{len(aggs)} aggregations."
                )
                success += 1

            except Exception as e:
                a["error"] = str(e)
                errors += 1

        # ----------------------------------------------------------
        # WINDOW
        # ----------------------------------------------------------
        elif rtype == "window":
            try:
                wa = analyse_window(recipe)
                a["window_analysis"] = wa

                for col in wa.get("partition_by", []):
                    a["columns_by_behavior"][col] = "PARTITION_KEY"
                    add_to_index(column_index, col, name, rtype, "PARTITION_KEY")

                for col in wa.get("order_by", []):
                    a["columns_by_behavior"][col] = "ORDER_KEY"
                    add_to_index(column_index, col, name, rtype, "ORDER_KEY")

                for w in wa.get("window_columns", []):
                    col = w.get("name", "")
                    a["columns_by_behavior"][col] = "WINDOW_FUNCTION"
                    add_to_index(column_index, col, name, rtype, "WINDOW_FUNCTION")

                if gen_sql:
                    a["sql_analysis"] = analyse_sql(gen_sql)

                a["all_columns"] = wa.get("all_columns", [])
                a["recipe_summary"] = (
                    f"Window recipe. "
                    f"Partition by: {', '.join(wa.get('partition_by',[])[:3]) or 'none'}. "
                    f"Order by: {', '.join(wa.get('order_by',[])[:3]) or 'none'}."
                )
                success += 1

            except Exception as e:
                a["error"] = str(e)
                errors += 1

        # ----------------------------------------------------------
        # ALL OTHER TYPES (sync, prepare, split, topn etc.)
        # ----------------------------------------------------------
        else:
            a["recipe_summary"] = (
                f"Recipe type '{rtype}'. "
                f"Reads: {', '.join(inputs[:2]) or 'none'}. "
                f"Writes: {', '.join(outputs[:2]) or 'none'}."
            )
            success += 1

        recipe_analyses.append(a)

    print(f"\n[OK] Analysed: {success}  |  Errors: {errors}")

    # Statistics
    behavior_counts    = {}
    recipe_type_counts = {}

    for a in recipe_analyses:
        rt = a.get("recipe_type", "unknown")
        recipe_type_counts[rt] = recipe_type_counts.get(rt, 0) + 1
        for beh in a.get("columns_by_behavior", {}).values():
            behavior_counts[beh] = behavior_counts.get(beh, 0) + 1

    top_columns = sorted(
        {col: len(occ) for col, occ in column_index.items()}.items(),
        key=lambda x: -x[1]
    )[:20]

    # Build outputs
    ARIS_METADATA = {
        "aris_version":    "1.0",
        "phase":           "Phase 3 - Code Intelligence",
        "project":         PROJECT_KEY,
        "generated_at":    datetime.now().isoformat(timespec="seconds"),
        "stale_after_days": STALE_AFTER_DAYS
    }

    code_intelligence = {
        **ARIS_METADATA,
        "analysis_summary": {
            "total_recipes":          len(recipes),
            "recipes_analysed":       success,
            "recipes_with_errors":    errors,
            "recipe_type_breakdown":  recipe_type_counts,
            "behavior_counts":        behavior_counts,
            "unique_columns_found":   len(column_index),
            "top_columns_by_frequency": [
                {"column": col, "recipe_count": count}
                for col, count in top_columns
            ]
        },
        "recipe_analyses": recipe_analyses
    }

    column_index_output = {
        **ARIS_METADATA,
        "phase":        "Phase 3 - Column Index",
        "column_count": len(column_index),
        "columns":      column_index
    }

    # Markdown for LLM
    def build_md(data):
        lines = [
            "# ARIS Code Intelligence",
            f"\n**Project:** {data['project']}",
            f"**Generated:** {data['generated_at']}",
            f"\n> Give this file to Claude or Copilot with the other ARIS files.",
            f"> The LLM will know exactly how every recipe handles every column.\n"
        ]
        s = data["analysis_summary"]
        lines += [
            "---\n## Summary\n",
            "| Metric | Value |", "|---|---|",
            f"| Recipes analysed | {s['recipes_analysed']} |",
            f"| Unique columns found | {s['unique_columns_found']} |",
            f"| Recipes with errors | {s['recipes_with_errors']} |",
            "\n**Recipe types:**"
        ]
        for rt, count in sorted(s.get("recipe_type_breakdown", {}).items()):
            lines.append(f"- {rt}: {count}")
        lines.append("\n**Column behavior distribution:**")
        for beh, count in sorted(s.get("behavior_counts", {}).items(), key=lambda x: -x[1]):
            lines.append(f"- {beh}: {count}")
        lines.append("\n**Top columns (most widely used):**")
        for item in s.get("top_columns_by_frequency", [])[:15]:
            lines.append(f"- `{item['column']}` - {item['recipe_count']} recipe(s)")
        lines.append("\n---\n## Recipe Analysis\n")

        for a in data.get("recipe_analyses", []):
            lines.append(f"### {a.get('recipe_name','')}")
            lines.append(
                f"**Type:** {a.get('recipe_type','')} | "
                f"**In:** {', '.join(a.get('inputs',[])[:3]) or 'none'} | "
                f"**Out:** {', '.join(a.get('outputs',[])[:3]) or 'none'}"
            )
            if a.get("recipe_summary"): lines.append(f"\n{a['recipe_summary']}")
            if a.get("warning"):        lines.append(f"\n> [WARNING] {a['warning']}")
            if a.get("error"):          lines.append(f"\n> [ERROR] {a['error']}")

            if a.get("columns_by_behavior"):
                lines += ["", "| Column | Behavior |", "|---|---|"]
                for col, beh in sorted(a["columns_by_behavior"].items()):
                    lines.append(f"| `{col}` | {beh} |")

            ja = a.get("join_analysis", {})
            if ja.get("join_keys"):
                lines.append("\n**Join keys:**")
                for jk in ja["join_keys"]:
                    lines.append(f"- `{jk['left']}` = `{jk['right']}`")

            ga = a.get("group_analysis", {})
            if ga.get("group_keys"):
                lines.append(f"\n**Group by:** {', '.join([f'`{k}`' for k in ga['group_keys']])}")

            wa = a.get("window_analysis", {})
            if wa.get("partition_by"):
                lines.append(f"\n**Partition by:** {', '.join([f'`{c}`' for c in wa['partition_by']])}")

            pa = a.get("python_analysis", {})
            if pa.get("operations"):
                lines.append(f"\n**Operations:** {', '.join(pa['operations'])}")

            lines.append("")
        return "\n".join(lines)

    def build_sql_md(all_recipes):
        lines = [
            "# ARIS SQL Summary",
            f"\n**Project:** {PROJECT_KEY}",
            f"**Generated:** {datetime.now().isoformat(timespec='seconds')}",
            f"\n> All SQL code in one file for LLM reference.\n"
        ]
        count = 0
        for r in all_recipes:
            sql = r.get("payload", "") or r.get("generated_sql", "") or ""
            if r.get("recipe_type") not in (
                "sql_query", "sql_script", "hive", "spark_sql"
            ) and not r.get("generated_sql"):
                continue
            if not sql:
                continue
            count += 1
            lines += [
                f"## {r.get('recipe_name','')}",
                f"**Type:** {r.get('recipe_type','')}",
                f"**Reads:** {', '.join(r.get('inputs',[]))}",
                f"**Writes:** {', '.join(r.get('outputs',[]))}",
                f"\n```sql\n{sql.strip()}\n```\n"
            ]
        lines.insert(4, f"**Total SQL recipes:** {count}\n")
        return "\n".join(lines)

    code_md = build_md(code_intelligence)
    sql_md  = build_sql_md(recipes)

