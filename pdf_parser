def run_visio_converter():

    print("=" * 80)
    print("ARIS v1.0 | Visio PDF Converter")
    print("=" * 80)
    print(f"Project      : {PROJECT_KEY}")
    print(f"PDF File     : {PDF_FILENAME}")
    print(f"Flow Name    : {FLOW_NAME}")
    print(f"Started      : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 80)

    os.makedirs(LOCAL_OUTPUT_DIR, exist_ok=True)
    os.makedirs(LOCAL_PDF_DIR, exist_ok=True)

    pdf_file = pdf_path(PDF_FILENAME)
    if not os.path.exists(pdf_file):
        print(f"\n[ERROR] PDF not found: {pdf_file}")
        print(f"   Place your PDF in the pdfs\\ folder")
        print(f"   Update PDF_FILENAME in config\\aris_config.py")
        return

    # ----------------------------------------------------------
    # EXTRACT TEXT BLOCKS
    # ----------------------------------------------------------
    print(f"\nReading PDF: {pdf_file}")
    blocks = extract_text_blocks(pdf_file)
    print(f"[OK] Extracted {len(blocks)} text blocks")

    # ----------------------------------------------------------
    # EXTRACT VERSION HISTORY
    # ----------------------------------------------------------
    print("\nExtracting version history...")
    version_history = extract_version_history(blocks)
    print(f"[OK] Version entries found: {len(version_history['versions'])}")
    if version_history["versions"]:
        for v in version_history["versions"]:
            print(f"     v{v['version']} | {v['date']} | {v['description'][:50]}")

    # ----------------------------------------------------------
    # CLASSIFY BLOCKS
    # ----------------------------------------------------------
    for block in blocks:
        block["shape_type"] = classify_block(block, blocks)

    type_counts = {}
    for block in blocks:
        t = block["shape_type"]
        type_counts[t] = type_counts.get(t, 0) + 1

    print(f"\nShape classification:")
    for shape_type, count in type_counts.items():
        print(f"  {shape_type:<15} : {count}")

    # ----------------------------------------------------------
    # BUILD FLOW SEQUENCE
    # ----------------------------------------------------------
    flow      = build_flow_sequence(blocks)
    decisions = flow["decisions"]

    print(f"\nFlow structure:")
    print(f"  Metadata items : {len(flow['metadata'])}")
    print(f"  Decision nodes : {len(decisions)}")
    print(f"  Process steps  : {len(flow['processes'])}")
    print(f"  End states     : {len(flow['end_states'])}")

    # ----------------------------------------------------------
    # GENERATE SQL SUGGESTIONS
    # ----------------------------------------------------------
    print(f"\nGenerating SQL suggestions...")

    all_column_hints = []

    for decision in decisions:
        sql, conf, hints, notes = generate_sql(
            decision["condition"],
            SQL_CONFIDENCE
        )
        decision["sql_suggestion"] = sql
        decision["sql_confidence"] = conf
        decision["column_hints"]   = hints
        decision["sql_notes"]      = notes
        all_column_hints.extend(hints)

        conf_label = "[HIGH]" if conf == "HIGH" else "[MEDIUM]" if conf == "MEDIUM" else "[LOW]"
        print(f"  {conf_label} Step {decision['step_number']}: {decision['condition'][:55]}")
        if sql:
            print(f"     SQL: {sql[:70]}")

    combined_sql  = build_combined_sql(decisions)
    unique_hints  = list(dict.fromkeys(all_column_hints))

    # ----------------------------------------------------------
    # BUILD JSON OUTPUT
    # ----------------------------------------------------------
    ARIS_METADATA = {
        "aris_version":    "1.0",
        "phase":           "Visio PDF Converter",
        "project":         PROJECT_KEY,
        "generated_at":    datetime.now().isoformat(timespec="seconds"),
        "source_file":     PDF_FILENAME,
        "flow_name":       FLOW_NAME
    }

    design_context = {
        **ARIS_METADATA,
        "version_history":   version_history,
        "campaign_metadata": flow["metadata"],
        "flow_summary": {
            "total_decisions":   len(decisions),
            "total_processes":   len(flow["processes"]),
            "high_confidence":   sum(1 for d in decisions if d.get("sql_confidence") == "HIGH"),
            "medium_confidence": sum(1 for d in decisions if d.get("sql_confidence") == "MEDIUM"),
            "manual_review":     sum(1 for d in decisions if d.get("sql_confidence") == "LOW")
        },
        "decision_nodes":  decisions,
        "process_steps":   flow["processes"],
        "end_states":      flow["end_states"],
        "column_hints":    unique_hints,
        "generated_sql": {
            "combined_where_clause": combined_sql,
            "note": (
                "Review MEDIUM confidence conditions before using in production. "
                "Verify column names against ARIS_DATASET_REGISTRY.json"
            )
        }
    }

    # ----------------------------------------------------------
    # BUILD MARKDOWN
    # ----------------------------------------------------------
    markdown = build_markdown(design_context)

    # ----------------------------------------------------------
    # SAVE OUTPUTS
    # ----------------------------------------------------------
    def save_json(filename, data):
        path = output_path(filename)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, default=str)
        print(f"  [SAVED] {filename}")

    def save_text(filename, text):
        path = output_path(filename)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"  [SAVED] {filename}")

    print("\nSaving outputs...")
    save_json(DESIGN_CONTEXT_FILE, design_context)
    save_text(DESIGN_CONTEXT_MD,   markdown)

    # ----------------------------------------------------------
