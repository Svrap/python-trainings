    # ----------------------------------------------------------
    print("\n")
    print("=" * 80)
    print("ARIS Visio PDF Converter Complete")
    print("=" * 80)
    print(f"Project          : {PROJECT_KEY}")
    print(f"Completed        : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"Decision nodes   : {len(decisions)}")
    print(f"Version history  : {len(version_history['versions'])} entries")
