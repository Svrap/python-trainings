def build_json_output(flow, project_key, source_file, flow_name):
    """Build clean JSON output from extracted flow."""

    ARIS_METADATA = {
        "aris_version":  "1.1",
        "phase":         "Visio Extractor",
        "project":       project_key,
        "generated_at":  datetime.now().isoformat(timespec="seconds"),
        "source_file":   source_file,
        "source_type":   flow.get("source_type", "unknown"),
        "flow_name":     flow_name
    }

    return {
        **ARIS_METADATA,
        "document_info":   flow.get("document_info", {}),
        "pages":           flow.get("pages", []),
        "flow_summary": {
            "total_pages":     len(flow.get("pages", [])),
            "total_decisions": len(flow.get("decisions", [])),
            "total_processes": len(flow.get("processes", [])),
            "total_end_states":len(flow.get("end_states", [])),
            "total_connectors":len(flow.get("connectors", [])),
            "unknown_shapes":  len(flow.get("unknown_shapes", [])),
            "total_business_rules": len(flow.get("business_rules", [])),
            "total_relationships": len(flow.get("relationships", [])),
            "source_type":     flow.get("source_type", "unknown"),
            "accuracy_note":   (
                "Native VSDX extraction - master names, text rules, grouped shapes, and Connect rows"
                if flow.get("source_type") == "vsdx"
                else "Medium accuracy - shape types inferred from text (PDF fallback)"
            )
        },
        "campaign_metadata": flow.get("metadata", []),
        "decision_rules":    flow.get("decisions", []),
        "process_steps":     flow.get("processes", []),
        "end_states":        flow.get("end_states", []),
        "connectors":        flow.get("connectors", []),
        "relationships":     flow.get("relationships", flow.get("connectors", [])),
        "process_flow":      flow.get("process_flow", []),
        "business_rules":    flow.get("business_rules", []),
        "data_inputs":       flow.get("data_inputs", []),
        "data_outputs":      flow.get("data_outputs", []),
        "match_conditions":  flow.get("match_conditions", []),
        "diagnostics":       flow.get("diagnostics", {}),
        "notes":             flow.get("notes", []),
        "unknown_shapes":    flow.get("unknown_shapes", []),
        "warning":           flow.get("warning", ""),
        "warnings":          flow.get("warnings", [])
    }


def build_markdown_output(data):
    """
    Build human-readable markdown.
    Clean, structured, ready for LLM consumption.
    No SQL. No interpretation. Just what the Visio says.
    """
    lines = []

    lines.append("# ARIS Design Context")
    lines.append(f"\n**Project:** {data['project']}")
    lines.append(f"**Flow:** {data['flow_name']}")
    lines.append(f"**Source:** {data['source_file']} ({data['source_type']})")
    lines.append(f"**Generated:** {data['generated_at']}")

    if data.get("warning"):
        lines.append(f"\n> [WARNING] {data['warning']}")
    for warning in data.get("warnings", []):
        lines.append(f"\n> [WARNING] {warning}")

    # Document info
    doc_info = data.get("document_info", {})
    if any(v for v in doc_info.values()):
        lines.append("\n---\n## Document Information\n")
        for key, val in doc_info.items():
            if val:
                lines.append(f"- **{key.replace('_', ' ').title()}:** {val}")

    # Campaign metadata from START shapes
    if data.get("campaign_metadata"):
        lines.append("\n---\n## Campaign / Flow Metadata\n")
        lines.append("> Extracted from start shapes at top of Visio diagram\n")
        for item in data["campaign_metadata"]:
            lines.append(f"- {item}")

    # Flow summary
    summary = data["flow_summary"]
    lines.append("\n---\n## Flow Summary\n")
    lines.append("| Metric | Value |")
    lines.append("|---|---|")
    lines.append(f"| Source type | {summary['source_type']} |")
    lines.append(f"| Accuracy | {summary['accuracy_note']} |")
    lines.append(f"| Decision rules (diamonds) | {summary['total_decisions']} |")
    lines.append(f"| Process steps (rectangles) | {summary['total_processes']} |")
    lines.append(f"| End states (hexagons) | {summary['total_end_states']} |")
    lines.append(f"| Connectors traced | {summary['total_connectors']} |")
    lines.append(f"| Business rules detected | {summary.get('total_business_rules', 0)} |")
    lines.append(f"| Directed relationships | {summary.get('total_relationships', 0)} |")
    if summary["unknown_shapes"] > 0:
        lines.append(f"| Unclassified shapes | {summary['unknown_shapes']} (review manually) |")

    # Business rules are semantic findings and are independent of visual shape type.
    lines.append("\n---\n## Business Rules\n")
    lines.append("> Rule text is detected from exact Visio wording. Visual decision diamonds are reported separately.\n")
    rules = data.get("business_rules", [])
    if not rules:
        lines.append("_No business-rule text was detected._")
    else:
        for rule in rules:
            lines.append(
                f"- **{rule.get('rule_id', 'RULE')}:** {rule.get('text', '')} "
                f"_({rule.get('rule_kind', 'BUSINESS_RULE')}; visual shape: {rule.get('shape_type', 'UNKNOWN')})_"
            )

    decisions = data.get("decision_rules", [])
    lines.append("\n---\n## Visual Decision Points\n")
    if not decisions:
        lines.append("_No Visio decision-diamond shapes were found._")
    else:
        for decision in decisions:
            lines.append(f"### Decision {decision.get('step_number', '?')}: {decision.get('text', '')}\n")
            paths = []
            if decision.get("yes_path", {}).get("target_id"):
                paths.append(("YES", decision.get("yes_path", {})))
            if decision.get("no_path", {}).get("target_id"):
                paths.append(("NO", decision.get("no_path", {})))
            for other in decision.get("other_paths", []):
                paths.append((other.get("label") or "UNLABELED", other))
            if paths:
                lines.append("| Path | Action | Leads To |")
                lines.append("|---|---|---|")
                for label, path in paths:
                    lines.append(f"| {label} | {path.get('action', 'continue')} | {path.get('target_text') or path.get('target_id', '')} |")
            else:
                lines.append("_No outgoing connector could be mapped to this decision._")

    # Reconstructed process flow
    process_flow = data.get("process_flow", [])
    if process_flow:
        lines.append("\n---\n## Reconstructed Process Flow\n")
        lines.append("> Sequence is derived only from extracted Visio connectors. Unconnected shapes are listed separately.\n")
        for item in process_flow:
            indent = "  " * int(item.get("depth", 0))
            next_ids = ", ".join(item.get("next_shape_ids", [])) or "END / unconnected"
            lines.append(
                f"{indent}{item.get('sequence', '?')}. "
                f"[{item.get('type', 'UNKNOWN')}] {item.get('text', '')} "
                f"(next: {next_ids})"
            )

    # Relationships
    relationships = data.get("relationships", [])
    if relationships:
        lines.append("\n---\n## Shape Relationships\n")
        lines.append("| From | Branch | To | Direction |")
        lines.append("|---|---|---|---|")
        for rel in relationships:
            direction = "inferred" if rel.get("direction_inferred") else "Visio BeginX/EndX"
            lines.append(
                f"| {rel.get('from_shape_text') or rel.get('from_shape_id', '')} "
                f"| {rel.get('label') or '-'} "
                f"| {rel.get('to_shape_text') or rel.get('to_shape_id', '')} "
                f"| {direction} |"
            )

    # Process steps
    processes = data.get("process_steps", [])
    if processes:
        lines.append("\n---\n## Process Steps\n")
        lines.append("> Action steps from rectangular shapes in the Visio diagram.\n")
        for i, proc in enumerate(processes, 1):
            text = proc.get("text", proc.get("action", ""))
            lines.append(f"{i}. {text}")

    # End states
    end_states = data.get("end_states", [])
    if end_states:
        lines.append("\n---\n## End States\n")
        for state in end_states:
            lines.append(f"- {state}")

    # Unknown shapes
    unknowns = data.get("unknown_shapes", [])
    if unknowns:
        lines.append("\n---\n## Unclassified Shapes\n")
        lines.append("> These shapes could not be classified automatically.")
        lines.append("> Review manually and add to correct section if needed.\n")
        for shape in unknowns:
            text = shape.get("text", "")
            lines.append(f"- {text}")

    # Notes
    notes = data.get("notes", [])
    if notes:
        lines.append("\n---\n## Notes and Legends\n")
        lines.append("> Extracted from information boxes and outside-flow text.\n")
        for note in notes[:20]:  # limit to first 20
            lines.append(f"- {note}")

    diagnostics = data.get("diagnostics", {})
    if diagnostics:
        lines.append("\n---\n## Extraction Diagnostics\n")
        for key, value in diagnostics.items():
            lines.append(f"- **{key.replace('_', ' ').title()}:** {value}")

    # How to use with LLM
    lines.append("\n---\n## How to Use This File With LLM\n")
    lines.append("Give this file to Claude or Copilot alongside the ARIS recipe intelligence files.")
    lines.append("Ask questions like:\n")
    lines.append('- "Which recipes implement RULE_001? Show the matching code evidence."')
    lines.append('- "Which Dataiku recipes implement the extracted attendance and matching rules?"')
    lines.append('- "What actual dataset columns map to each extracted match condition?"')
    lines.append('- "Are all business rules from this Visio implemented in the data pipeline?"')
    lines.append('- "Generate a WHERE clause for Rule 1 based on the actual dataset columns."')

    return "\n".join(lines)


