def run_visio_extractor():

    print("=" * 80)
    print("ARIS v1.1 | Visio Extractor")
    print("=" * 80)
    print(f"Project      : {PROJECT_KEY}")
    print(f"Visio File   : {VISIO_FILE}")
    print(f"Started      : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 80)

    os.makedirs(LOCAL_OUTPUT_DIR, exist_ok=True)
    os.makedirs(LOCAL_PDF_DIR,    exist_ok=True)

    file_path = pdf_path(VISIO_FILE)

    if not os.path.exists(file_path):
        print(f"\n[ERROR] File not found: {file_path}")
        print(f"   Place your Visio file in: {LOCAL_PDF_DIR}\\")
        print(f"   Update VISIO_FILE in config\\aris_config.py")
        return

    ext = os.path.splitext(VISIO_FILE)[1].lower()

    # ----------------------------------------------------------
    # EXTRACT
    # ----------------------------------------------------------
    print(f"\nExtracting from {ext} file...")

    if ext == ".vsdx":
        print("[INFO] Using vsdx extractor (high accuracy)")
        flow = extract_from_vsdx(file_path)
    elif ext in (".pdf",):
        print("[INFO] Using PDF extractor (medium accuracy)")
        print("[INFO] For better results get the .vsdx file")
        flow = extract_from_pdf(file_path)
    else:
        print(f"[ERROR] Unsupported file type: {ext}")
        print("   Supported: .vsdx .pdf")
        return

    if flow is None:
        print("[ERROR] Extraction failed. Check error messages above.")
        return

    decisions = flow.get("decisions", [])
    processes = flow.get("processes", [])
    print(f"\n[OK] Extraction complete:")
    print(f"  Decision rules : {len(decisions)}")
    print(f"  Process steps  : {len(processes)}")
    print(f"  End states     : {len(flow.get('end_states', []))}")
    print(f"  Connectors     : {len(flow.get('connectors', []))}")
    print(f"  Business rules : {len(flow.get('business_rules', []))}")
    print(f"  Relationships  : {len(flow.get('relationships', []))}")
    print(f"  Unknown shapes : {len(flow.get('unknown_shapes', []))}")

    if flow.get("unknown_shapes"):
        print(f"\n[WARNING] {len(flow['unknown_shapes'])} unclassified shapes found:")
        for s in flow["unknown_shapes"][:5]:
            print(f"   - {s.get('text', '')[:60]}")
        if len(flow["unknown_shapes"]) > 5:
            print(f"   ... and {len(flow['unknown_shapes']) - 5} more")

    # ----------------------------------------------------------
    # DETERMINE FLOW NAME
    # ----------------------------------------------------------
    metadata = flow.get("metadata", [])
    flow_name = (
        metadata[0]
        if metadata
        else os.path.splitext(VISIO_FILE)[0]
    )

    # ----------------------------------------------------------
    # BUILD OUTPUTS
    # ----------------------------------------------------------
    json_output = build_json_output(flow, PROJECT_KEY, VISIO_FILE, flow_name)
    md_output   = build_markdown_output(json_output)

    # ----------------------------------------------------------
    # SAVE
    # ----------------------------------------------------------
    def save_json(filename, data):
        path = output_path(filename)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, default=str)
        print(f"  [SAVED] {filename}")

    def save_text(filename, text):
        path = output_path(filename)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"  [SAVED] {filename}")

    print("\nSaving outputs...")
    save_json(DESIGN_CONTEXT_FILE, json_output)
    save_text(DESIGN_CONTEXT_MD,   md_output)

    # ----------------------------------------------------------
    # FINAL STATUS
    # ----------------------------------------------------------
    print("\n")
    print("=" * 80)
    print("ARIS Visio Extractor Complete")
    print("=" * 80)
    print(f"Project          : {PROJECT_KEY}")
    print(f"Source           : {VISIO_FILE} ({ext})")
    print(f"Completed        : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"Decision rules   : {len(decisions)}")
    print(f"Process steps    : {len(processes)}")
    print()

    if decisions:
        print("Decision rules extracted:")
        for d in decisions:
            step = d.get("step_number", "?")
            text = d.get("text", d.get("condition", ""))
            yes  = d.get("yes_path", {}).get("action", "?")
            no   = d.get("no_path",  {}).get("action", "?")
            print(f"  Rule {step}: {text[:60]}")
            print(f"    YES -> {yes} | NO -> {no}")

    print()
    print(f"Output files in: {LOCAL_OUTPUT_DIR}\\")
    print(f"  [SAVED] {DESIGN_CONTEXT_FILE}")
    print(f"  [SAVED] {DESIGN_CONTEXT_MD}")
    print()
    print("Next steps:")
    print("  1. Review " + DESIGN_CONTEXT_MD)
    print("  2. Give md file to LLM (Claude/Copilot) with Phase 1 files")
    print("  3. Ask LLM to map rules to actual recipe columns")
    print("  4. Run: python phase2_impact\\impact.py")
    print("=" * 80)


if __name__ == "__main__":
    run_visio_extractor()
