# ==========================================================================
# STEP 2 - BUILD BIDIRECTIONAL GRAPH
#
# We build two adjacency maps:
#   forward_graph  — dataset → [recipes] → [datasets] (downstream)
#   backward_graph — dataset ← [recipes] ← [datasets] (upstream)
#
# This allows us to trace both directions from any starting point.
# ==========================================================================

# forward_graph[node] = list of nodes this node points TO
forward_graph = {}

# backward_graph[node] = list of nodes that point TO this node
backward_graph = {}

def add_edge(graph, source, target):
    """Add a directed edge to an adjacency map."""
    if source not in graph:
        graph[source] = []
    if target not in graph[source]:
        graph[source].append(target)

for edge in edges:
    source = edge.get("source")
    target = edge.get("target")
    relationship = edge.get("relationship", "")

    if not source or not target:
        continue

    # INPUT edge: dataset → recipe
    # OUTPUT edge: recipe → dataset
    # Both directions captured
    add_edge(forward_graph, source, target)
    add_edge(backward_graph, target, source)

all_nodes = set(forward_graph.keys()) | set(backward_graph.keys())

print(f"\n✅ Graph built: {len(all_nodes)} nodes | {len(edges)} edges")
print(f"   Forward connections  : {sum(len(v) for v in forward_graph.values())}")
print(f"   Backward connections : {sum(len(v) for v in backward_graph.values())}")

