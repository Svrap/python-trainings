def build_markdown_report(impact_data):
    """Generate a human-readable impact analysis report."""

    lines = []
    meta = impact_data

    lines.append("# ARIS Impact Analysis Report")
    lines.append(f"\n**Project:** {meta['project']}")
    lines.append(f"**Generated:** {meta['generated_at']}")
    lines.append(f"**Change Request:** {meta['change_request']}")
    lines.append(f"**Search Terms:** {', '.join(meta['search_terms'])}")

    # Graph summary
    g = meta["graph_summary"]
    lines.append("\n---\n")
    lines.append("## Project Graph Summary\n")
    lines.append(f"| Metric | Count |")
    lines.append(f"|---|---|")
    lines.append(f"| Total datasets | {g['total_datasets']} |")
    lines.append(f"| Total recipes | {g['total_recipes']} |")
    lines.append(f"| Total flow edges | {g['total_edges']} |")
    lines.append(f"| Root datasets (source) | {len(g['root_datasets'])} |")
    lines.append(f"| Terminal datasets (output) | {len(g['terminal_datasets'])} |")

    if g["root_datasets"]:
        lines.append(f"\n**Root Datasets (original data sources):**")
        for r in g["root_datasets"]:
            lines.append(f"- {r}")

    if g["terminal_datasets"]:
        lines.append(f"\n**Terminal Datasets (final outputs):**")
        for t in g["terminal_datasets"]:
            lines.append(f"- {t}")

    # Per-attribute impact
    lines.append("\n---\n")
    lines.append("## Attribute Impact Analysis\n")

    for term, result in meta["attribute_impact"].items():

        lines.append(f"### Attribute: `{term}`\n")

        if result["status"] == "NOT_FOUND":
            lines.append(f"⚠️ **Not found** in any dataset schema.")
            lines.append(f"> {result['message']}\n")
            continue

        lines.append(f"**Status:** Found | **Complexity:** {result['complexity']} | **Risk:** {result['risk']}\n")

        # Matches
        lines.append("**Where it exists:**\n")
        lines.append("| Dataset | Column | Match Type |")
        lines.append("|---|---|---|")
        for m in result["matches"]:
            lines.append(f"| {m['dataset']} | {m['column']} | {m['match_type']} |")

        # Upstream
        up = result["upstream"]
        lines.append(f"\n**Upstream (data sources — {up['recipe_count']} recipes, {up['dataset_count']} datasets):**\n")
        if up["recipes"]:
            lines.append("| Recipe | Type | Hop |")
            lines.append("|---|---|---|")
            for r in sorted(up["recipes"], key=lambda x: x["hop"]):
                lines.append(f"| {r['name']} | {r['type']} | {r['hop']} |")
        else:
            lines.append("_No upstream recipes — this may be a root dataset._")

        # Downstream
        down = result["downstream"]
        lines.append(f"\n**Downstream impact (what changes affect — {down['recipe_count']} recipes, {down['dataset_count']} datasets):**\n")
        if down["recipes"]:
            lines.append("| Recipe | Type | Hop |")
            lines.append("|---|---|---|")
            for r in sorted(down["recipes"], key=lambda x: x["hop"]):
                lines.append(f"| {r['name']} | {r['type']} | {r['hop']} |")
        else:
            lines.append("_No downstream recipes — this may be a terminal dataset._")

        if down["datasets"]:
            lines.append(f"\n**Downstream datasets affected:**\n")
            for d in sorted(down["datasets"], key=lambda x: x["hop"]):
                lines.append(f"- `{d['name']}` (hop {d['hop']})")

        lines.append("\n---")

    # How to read
    lines.append("\n## How to Read This Report\n")
    lines.append("| Term | Meaning |")
    lines.append("|---|---|")
    lines.append("| Root dataset | Original data source — no upstream dependencies |")
    lines.append("| Terminal dataset | Final output — nothing downstream |")
    lines.append("| Hop | Distance from the source dataset in the flow graph |")
    lines.append("| EXACT match | Column name matches search term exactly |")
    lines.append("| PARTIAL match | Column name contains or is contained in search term |")
    lines.append("| HIGH complexity | 10+ downstream recipes affected |")
    lines.append("| MEDIUM complexity | 5-10 downstream recipes affected |")
    lines.append("| LOW complexity | Fewer than 5 downstream recipes affected |")

    lines.append("\n---")
    lines.append("\n## Next Step\n")
    lines.append("Run **ARIS Phase 3 — Transformation Intelligence** to understand")
    lines.append("exactly how each affected recipe handles the attribute.")

    return "\n".join(lines)

markdown_report = build_markdown_report(impact_analysis_json)

