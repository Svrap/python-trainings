# STEP 3 - ATTRIBUTE SEARCH
#
# For each search term — find all datasets that contain the attribute.
# Search is:
#   - Case-insensitive
#   - Exact match first (column name == search term)
#   - Partial match second (search term appears within column name)
# ==========================================================================

def search_attribute_in_datasets(search_term, datasets_info):
    """
    Search all datasets for a column matching the search term.
    Returns list of matches with match type (exact or partial).
    """
    matches = []
    search_upper = search_term.upper().strip()

    for dataset_name, dataset_data in datasets_info.items():
        columns = dataset_data.get("columns", [])

        for col in columns:
            col_upper = col.upper().strip()

            if col_upper == search_upper:
                matches.append({
                    "dataset": dataset_name,
                    "column": col,
                    "match_type": "EXACT"
                })
                break
            elif search_upper in col_upper or col_upper in search_upper:
                matches.append({
                    "dataset": dataset_name,
                    "column": col,
                    "match_type": "PARTIAL"
                })
                break

    return matches

print("\nSearching for attributes...")

attribute_matches = {}

for term in SEARCH_TERMS:
    matches = search_attribute_in_datasets(term, datasets_info)
    attribute_matches[term] = matches

    exact = [m for m in matches if m["match_type"] == "EXACT"]
    partial = [m for m in matches if m["match_type"] == "PARTIAL"]

    print(f"  '{term}' → {len(exact)} exact matches | {len(partial)} partial matches")

    if not matches:
        print(f"  ⚠️  '{term}' not found in any dataset schema")

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# ==========================================================================
# STEP 4 - BFS TRAVERSAL (UPSTREAM AND DOWNSTREAM)
#
# For each matching dataset — run BFS in both directions:
#
# DOWNSTREAM BFS (forward_graph):
#   From the matching dataset, follow edges forward.
#   This tells us: what will be affected if we change this column?
#
# UPSTREAM BFS (backward_graph):
#   From the matching dataset, follow edges backward.
#   This tells us: where does this data come from originally?
#
# We separate recipes and datasets in the results.
# ==========================================================================

def bfs_traverse(start_node, graph, max_hops, exclude_start=True):
    """
    BFS traversal from start_node through the graph.
    Returns separate lists of datasets and recipes visited,
    with hop count (distance from start).
    """
    visited = set()
    queue = deque([(start_node, 0)])
    datasets_found = []
    recipes_found = []

    while queue:
        node, hop = queue.popleft()

        if node in visited:
            continue
        visited.add(node)

        if hop > max_hops:
            continue

        # Skip the starting node itself if requested
        if exclude_start and node == start_node:
            pass
        else:
            # Classify node as dataset or recipe
            if node in datasets_info:
                if node != start_node or not exclude_start:
                    datasets_found.append({
                        "name": node,
                        "hop": hop,
                        "columns": datasets_info[node].get("columns", [])
                    })
            elif node in recipes_info:
                recipes_found.append({
                    "name": node,
                    "hop": hop,
                    "type": recipes_info[node].get("recipe_type", "unknown"),
                    "inputs": recipes_info[node].get("inputs", []),
                    "outputs": recipes_info[node].get("outputs", [])
                })

        # Add neighbours to queue
        for neighbour in graph.get(node, []):
            if neighbour not in visited:
                queue.append((neighbour, hop + 1))

    return datasets_found, recipes_found

