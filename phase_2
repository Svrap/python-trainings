# ==========================================================================
# STEP 5 - RUN TRAVERSAL FOR ALL MATCHED ATTRIBUTES
# ==========================================================================

print("\nRunning graph traversal...")

impact_results = {}

for term, matches in attribute_matches.items():

    print(f"\n  Attribute: '{term}'")

    if not matches:
        impact_results[term] = {
            "attribute": term,
            "status": "NOT_FOUND",
            "message": f"'{term}' not found in any dataset schema",
            "source_datasets": [],
            "downstream": {"datasets": [], "recipes": []},
            "upstream": {"datasets": [], "recipes": []}
        }
        continue

    # Collect all source datasets where attribute was found
    source_datasets = [m["dataset"] for m in matches]

    # Combine upstream and downstream across all source datasets
    all_downstream_datasets = {}
    all_downstream_recipes = {}
    all_upstream_datasets = {}
    all_upstream_recipes = {}

    for source_dataset in source_datasets:

        # DOWNSTREAM
        ds_down, rec_down = bfs_traverse(
            start_node=source_dataset,
            graph=forward_graph,
            max_hops=MAX_HOPS,
            exclude_start=True
        )

        for d in ds_down:
            if d["name"] not in all_downstream_datasets:
                all_downstream_datasets[d["name"]] = d

        for r in rec_down:
            if r["name"] not in all_downstream_recipes:
                all_downstream_recipes[r["name"]] = r

        # UPSTREAM
        ds_up, rec_up = bfs_traverse(
            start_node=source_dataset,
            graph=backward_graph,
            max_hops=MAX_HOPS,
            exclude_start=True
        )

        for d in ds_up:
            if d["name"] not in all_upstream_datasets:
                all_upstream_datasets[d["name"]] = d

        for r in rec_up:
            if r["name"] not in all_upstream_recipes:
                all_upstream_recipes[r["name"]] = r

    # Risk scoring
    downstream_recipe_count = len(all_downstream_recipes)
    downstream_dataset_count = len(all_downstream_datasets)

    if downstream_recipe_count > 10:
        complexity = "HIGH"
        risk = "HIGH"
    elif downstream_recipe_count > 4:
        complexity = "MEDIUM"
        risk = "MEDIUM"
    else:
        complexity = "LOW"
        risk = "LOW"

    impact_results[term] = {
        "attribute": term,
        "status": "FOUND",
        "matches": matches,
        "source_datasets": source_datasets,
        "complexity": complexity,
        "risk": risk,
        "downstream": {
            "datasets": list(all_downstream_datasets.values()),
            "recipes": list(all_downstream_recipes.values()),
            "dataset_count": downstream_dataset_count,
            "recipe_count": downstream_recipe_count
        },
        "upstream": {
            "datasets": list(all_upstream_datasets.values()),
            "recipes": list(all_upstream_recipes.values()),
            "dataset_count": len(all_upstream_datasets),
            "recipe_count": len(all_upstream_recipes)
        }
    }

    print(f"  ✅ Source datasets    : {len(source_datasets)}")
    print(f"  ✅ Downstream recipes : {downstream_recipe_count} ({complexity} complexity)")
    print(f"  ✅ Downstream datasets: {downstream_dataset_count}")
    print(f"  ✅ Upstream recipes   : {len(all_upstream_recipes)}")
    print(f"  ✅ Upstream datasets  : {len(all_upstream_datasets)}")

