def write_json_to_folder(folder, filename, payload):
    """Write a Python object as JSON to a Dataiku Managed Folder."""
    with folder.get_writer(filename) as writer:
        writer.write(
            json.dumps(payload, indent=2, default=str).encode("utf-8")
        )
    print(f"  ✅ Saved: {filename}")

def write_text_to_folder(folder, filename, text):
    """Write a text/markdown string to a Dataiku Managed Folder."""
    with folder.get_writer(filename) as writer:
        writer.write(text.encode("utf-8"))
    print(f"  ✅ Saved: {filename}")

