def run_phase3():

    print("=" * 80)
    print("ARIS v1.0 | Phase 3 - Code Intelligence")
    print("=" * 80)
    print(f"Project      : {PROJECT_KEY}")
    print(f"Started      : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 80)

    print("\nLoading Phase 1 outputs...")

    recipe_data  = load_json(RECIPE_INTELLIGENCE_FILE)
    dataset_data = load_json(DATASET_REGISTRY_FILE)

    generated_at_str = recipe_data.get("generated_at")
    if generated_at_str:
        try:
            generated_at = datetime.fromisoformat(generated_at_str)
            age_days = (datetime.now() - generated_at).days
            if age_days > STALE_AFTER_DAYS:
                print(f"[WARNING] Context is {age_days} days old. Consider re-running Phase 1.")
            else:
                print(f"[OK] Context age: {age_days} day(s)")
        except Exception:
            pass

    recipes  = recipe_data.get("recipes", [])
    datasets = dataset_data.get("datasets", {})

    print(f"[OK] Loaded {len(recipes)} recipes | {len(datasets)} datasets")

    print(f"\nAnalysing code in {len(recipes)} recipes...")

    recipe_analyses = []
    column_index    = {}
    error_count     = 0
    success_count   = 0

    for index, recipe in enumerate(recipes):

        name    = recipe.get("recipe_name", "")
        rtype   = recipe.get("recipe_type", "unknown")
        inputs  = recipe.get("inputs",  [])
        outputs = recipe.get("outputs", [])
        payload = recipe.get("payload", "") or ""
        code    = recipe.get("code",    "") or ""

        print(f"  [{index+1:>3}/{len(recipes)}] {name[:55]:<55}", end="\r")

        analysis = {
            "recipe_name":           name,
            "recipe_type":           rtype,
            "inputs":                inputs,
            "outputs":               outputs,
            "code_present":          bool(payload or code),
            "code_length":           len(payload or code),
            "sql_analysis":          {},
            "join_analysis":         {},
            "python_analysis":       {},
            "group_analysis":        {},
            "window_analysis":       {},
            "columns_by_behavior":   {},
            "all_columns_referenced":[],
            "recipe_summary":        ""
        }

        # ----------------------------------------------------------
        # SQL RECIPES
        # ----------------------------------------------------------
        if rtype in ("sql_query", "sql_script", "hive", "spark_sql"):

            if payload:
                try:
                    sql_analysis = extract_columns_from_sql(payload)
                    analysis["sql_analysis"] = sql_analysis

                    behaviors = {}
                    all_cols  = set()

                    for col_entry in sql_analysis.get("select_columns", []):
                        source = col_entry.get("source", "")
                        alias  = col_entry.get("alias",  "")
                        is_tx  = col_entry.get("transformed", False)
                        key    = alias or source
                        all_cols.add(key)
                        behaviors[key] = "TRANSFORMED" if is_tx else "PASSTHROUGH"

                    for agg in sql_analysis.get("aggregate_columns", []):
                        col = agg["column"]
                        behaviors[col] = "AGGREGATED"
                        all_cols.add(col)

                    for col in sql_analysis.get("case_columns", []):
                        behaviors[col] = "CALCULATED"
                        all_cols.add(col)

                    for col in sql_analysis.get("join_columns", []):
                        if col not in behaviors:
                            behaviors[col] = "JOIN_KEY"
                        all_cols.add(col)

                    for col in sql_analysis.get("group_columns", []):
                        if col not in behaviors:
                            behaviors[col] = "GROUPED"
                        all_cols.add(col)

                    for col in sql_analysis.get("where_columns", []):
                        if col not in behaviors:
                            behaviors[col] = "FILTER_RULE"
                        all_cols.add(col)

                    analysis["columns_by_behavior"]     = behaviors
                    analysis["all_columns_referenced"]  = list(all_cols)

                    sc = len(sql_analysis.get("select_columns",    []))
                    wc = len(sql_analysis.get("where_columns",     []))
                    ac = len(sql_analysis.get("aggregate_columns", []))
                    jc = len(sql_analysis.get("join_columns",      []))
                    gc = len(sql_analysis.get("group_columns",     []))

                    parts = [f"{sc} SELECT columns"]
                    if wc: parts.append(f"{wc} WHERE filters")
                    if ac: parts.append(f"{ac} aggregations")
                    if jc: parts.append(f"{jc} JOIN keys")
                    if gc: parts.append(f"{gc} GROUP BY")

                    analysis["recipe_summary"] = (
                        f"SQL recipe with {', '.join(parts)}. "
                        f"Reads from: {', '.join(inputs[:3])}. "
                        f"Writes to: {', '.join(outputs[:3])}."
                    )

                    for col, behavior in behaviors.items():
                        update_column_index(column_index, col, name, rtype, behavior)

                    success_count += 1

                except Exception as e:
                    analysis["error"] = str(e)
                    error_count += 1
            else:
                analysis["recipe_summary"] = "SQL recipe — no payload captured. Re-run Phase 1."
                analysis["warning"] = "No SQL payload available"

        # ----------------------------------------------------------
        # JOIN RECIPES
        # ----------------------------------------------------------
        elif rtype == "join":
            try:
                join_analysis = analyze_join_recipe(recipe)
                analysis["join_analysis"] = join_analysis

                all_cols = set()

                for jk in join_analysis.get("join_keys", []):
                    left  = jk.get("left",  "")
                    right = jk.get("right", "")
                    if left:
                        all_cols.add(left)
                        analysis["columns_by_behavior"][left] = "JOIN_KEY"
                        update_column_index(column_index, left, name, rtype, "JOIN_KEY")
                    if right:
                        all_cols.add(right)
                        analysis["columns_by_behavior"][right] = "JOIN_KEY"
                        update_column_index(column_index, right, name, rtype, "JOIN_KEY")

                for col_info in join_analysis.get("selected_columns", []):
                    col = col_info.get("name", "")
                    if col:
                        all_cols.add(col)
                        if col not in analysis["columns_by_behavior"]:
                            analysis["columns_by_behavior"][col] = "PASSTHROUGH"
                            update_column_index(column_index, col, name, rtype, "PASSTHROUGH")

                analysis["all_columns_referenced"] = list(all_cols)

                left_input   = join_analysis.get("left_input",   "")
                right_inputs = join_analysis.get("right_inputs", [])
                join_keys    = join_analysis.get("join_keys",    [])
                sel_cols     = join_analysis.get("selected_columns", [])

                analysis["recipe_summary"] = (
                    f"Join recipe ({join_analysis.get('join_type','unknown')} join). "
                    f"Left: {left_input}. "
                    f"Right: {', '.join(right_inputs[:2])}. "
                    f"Join keys: {len(join_keys)}. "
                    f"Output columns: {len(sel_cols)}."
                )

                success_count += 1

            except Exception as e:
                analysis["error"] = str(e)
                error_count += 1

        # ----------------------------------------------------------
        # PYTHON / PYSPARK / R RECIPES
        # ----------------------------------------------------------
        elif rtype in ("python", "pyspark", "r"):

            code_text = code or payload
            if code_text:
                try:
                    python_analysis = analyze_python_recipe(code_text)
                    analysis["python_analysis"] = python_analysis

                    all_cols = set(python_analysis.get("columns_referenced", []))
                    analysis["all_columns_referenced"] = list(all_cols)

                    for col in all_cols:
                        analysis["columns_by_behavior"][col] = "REFERENCED"
                        update_column_index(column_index, col, name, rtype, "REFERENCED")

                    ops = python_analysis.get("operations", [])
                    analysis["recipe_summary"] = (
                        f"Python/PySpark recipe. "
                        f"Operations: {', '.join(ops) if ops else 'see code'}. "
                        f"Columns referenced: {len(all_cols)}. "
                        f"Reads from: {', '.join(inputs[:3])}. "
                        f"Writes to: {', '.join(outputs[:3])}."
                    )
                    success_count += 1

                except Exception as e:
                    analysis["error"] = str(e)
                    error_count += 1
            else:
                analysis["recipe_summary"] = "Python recipe — no code captured. Re-run Phase 1."
                analysis["warning"] = "No code payload available"

        # ----------------------------------------------------------
        # GROUP / AGGREGATION RECIPES
        # ----------------------------------------------------------
        elif rtype in ("grouping", "group"):
            try:
                group_analysis = analyze_group_recipe(recipe)
                analysis["group_analysis"] = group_analysis

                all_cols = set(group_analysis.get("all_columns", []))
                analysis["all_columns_referenced"] = list(all_cols)

                for col in group_analysis.get("group_keys", []):
                    analysis["columns_by_behavior"][col] = "GROUPED"
                    update_column_index(column_index, col, name, rtype, "GROUPED")

                for agg in group_analysis.get("aggregations", []):
                    col = agg["column"]
                    analysis["columns_by_behavior"][col] = "AGGREGATED"
                    update_column_index(column_index, col, name, rtype, "AGGREGATED")

                keys = group_analysis.get("group_keys",   [])
                aggs = group_analysis.get("aggregations", [])
                analysis["recipe_summary"] = (
                    f"Group/Aggregation recipe. "
                    f"Group by: {', '.join(keys[:5]) if keys else 'none'}. "
                    f"Aggregations: {len(aggs)} columns. "
                    f"Reads from: {', '.join(inputs[:3])}. "
                    f"Writes to: {', '.join(outputs[:3])}."
                )
                success_count += 1

            except Exception as e:
                analysis["error"] = str(e)
                error_count += 1

        # ----------------------------------------------------------
        # WINDOW RECIPES
        # ----------------------------------------------------------
        elif rtype == "window":
            try:
                window_analysis = analyze_window_recipe(recipe)
                analysis["window_analysis"] = window_analysis

                all_cols = set(window_analysis.get("all_columns", []))
                analysis["all_columns_referenced"] = list(all_cols)

                for col in window_analysis.get("partition_by", []):
                    analysis["columns_by_behavior"][col] = "PARTITION_KEY"
                    update_column_index(column_index, col, name, rtype, "PARTITION_KEY")

                for col in window_analysis.get("order_by", []):
                    analysis["columns_by_behavior"][col] = "ORDER_KEY"
                    update_column_index(column_index, col, name, rtype, "ORDER_KEY")

                for w in window_analysis.get("window_columns", []):
                    col = w.get("name", "")
                    analysis["columns_by_behavior"][col] = "WINDOW_FUNCTION"
                    update_column_index(column_index, col, name, rtype, "WINDOW_FUNCTION")

                partition = window_analysis.get("partition_by",   [])
                ordering  = window_analysis.get("order_by",       [])
                windows   = window_analysis.get("window_columns", [])
                analysis["recipe_summary"] = (
                    f"Window recipe. "
                    f"Partition by: {', '.join(partition[:3]) if partition else 'none'}. "
                    f"Order by: {', '.join(ordering[:3]) if ordering else 'none'}. "
                    f"Window functions: {len(windows)}. "
                    f"Reads from: {', '.join(inputs[:3])}. "
                    f"Writes to: {', '.join(outputs[:3])}."
                )
                success_count += 1

            except Exception as e:
                analysis["error"] = str(e)
                error_count += 1

        # ----------------------------------------------------------
        # ALL OTHER RECIPE TYPES
        # Stack, Split, Distinct, TopN, Prepare, Sync, etc.
        # Store inputs/outputs for lineage — no deep code analysis
        # ----------------------------------------------------------
        else:
            analysis["recipe_summary"] = (
                f"Recipe type '{rtype}'. "
                f"Reads from: {', '.join(inputs[:3]) if inputs else 'none'}. "
                f"Writes to: {', '.join(outputs[:3]) if outputs else 'none'}."
            )
            success_count += 1

        recipe_analyses.append(analysis)

    print(f"\n[OK] Analysed: {success_count} | [ERROR] {error_count}")

    # ----------------------------------------------------------
    # STATISTICS
    # ----------------------------------------------------------
    behavior_counts    = {}
    recipe_type_counts = {}

    for a in recipe_analyses:
        rt = a.get("recipe_type", "unknown")
        recipe_type_counts[rt] = recipe_type_counts.get(rt, 0) + 1
        for col, behavior in a.get("columns_by_behavior", {}).items():
            behavior_counts[behavior] = behavior_counts.get(behavior, 0) + 1

    col_frequency = {col: len(occ) for col, occ in column_index.items()}
    top_columns   = sorted(col_frequency.items(), key=lambda x: -x[1])[:20]

    # ----------------------------------------------------------
    # BUILD JSON OUTPUTS
    # ----------------------------------------------------------
    ARIS_METADATA = {
        "aris_version":    "1.0",
        "phase":           "Phase 3 - Code Intelligence",
        "project":         PROJECT_KEY,
        "generated_at":    datetime.now().isoformat(timespec="seconds"),
        "stale_after_days": STALE_AFTER_DAYS
    }

    code_intelligence = {
        **ARIS_METADATA,
        "analysis_summary": {
            "total_recipes":          len(recipes),
            "recipes_analysed":       success_count,
            "recipes_with_errors":    error_count,
            "recipe_type_breakdown":  recipe_type_counts,
            "behavior_counts":        behavior_counts,
            "unique_columns_found":   len(column_index),
            "top_columns_by_frequency": [
                {"column": col, "recipe_count": count}
                for col, count in top_columns
            ]
        },
        "recipe_analyses": recipe_analyses
    }

    column_index_output = {
        **ARIS_METADATA,
        "phase":        "Phase 3 - Column Index",
        "description":  "Every column found across all recipes with behavior in each recipe.",
        "column_count": len(column_index),
        "columns":      column_index
    }

    # ----------------------------------------------------------
    # BUILD MARKDOWN FOR LLM
    # ----------------------------------------------------------
    def build_code_md(data):
        lines = []
        lines.append("# ARIS Code Intelligence")
        lines.append(f"\n**Project:** {data['project']}")
        lines.append(f"**Generated:** {data['generated_at']}")
        lines.append(f"\n> Give this file to Claude or Copilot alongside the other ARIS files.")
        lines.append(f"> With this file the LLM knows exactly how every recipe handles every column.")

        s = data["analysis_summary"]
        lines.append("\n---\n## Summary\n")
        lines.append("| Metric | Value |")
        lines.append("|---|---|")
        lines.append(f"| Recipes analysed | {s['recipes_analysed']} |")
        lines.append(f"| Unique columns found | {s['unique_columns_found']} |")
        lines.append(f"| Recipes with errors | {s['recipes_with_errors']} |")

        lines.append("\n**Recipe type breakdown:**")
        for rt, count in sorted(s.get("recipe_type_breakdown", {}).items()):
            lines.append(f"- {rt}: {count}")

        lines.append("\n**Column behavior distribution:**")
        for behavior, count in sorted(
            s.get("behavior_counts", {}).items(), key=lambda x: -x[1]
        ):
            lines.append(f"- {behavior}: {count}")

        lines.append("\n**Top columns (most widely used):**")
        for item in s.get("top_columns_by_frequency", [])[:15]:
            lines.append(f"- `{item['column']}` — {item['recipe_count']} recipe(s)")

        lines.append("\n---\n## Recipe Code Analysis\n")

        for a in data.get("recipe_analyses", []):
            name    = a.get("recipe_name", "")
            rtype   = a.get("recipe_type", "")
            inputs  = a.get("inputs",  [])
            outputs = a.get("outputs", [])
            summary = a.get("recipe_summary", "")
            behav   = a.get("columns_by_behavior", {})
            warning = a.get("warning", "")
            error   = a.get("error",   "")

            lines.append(f"### {name}")
            lines.append(
                f"**Type:** {rtype} | "
                f"**In:** {', '.join(inputs[:3]) or 'none'} | "
                f"**Out:** {', '.join(outputs[:3]) or 'none'}"
            )
            if summary:
                lines.append(f"\n{summary}")
            if warning:
                lines.append(f"\n> [WARNING] {warning}")
            if error:
                lines.append(f"\n> [ERROR] {error}")

            if behav:
                lines.append("\n| Column | Behavior |")
                lines.append("|---|---|")
                for col, behavior in sorted(behav.items()):
                    lines.append(f"| `{col}` | {behavior} |")

            # Python ops
            pa = a.get("python_analysis", {})
            if pa.get("operations"):
                lines.append(f"\n**Operations:** {', '.join(pa['operations'])}")
            if pa.get("columns_referenced"):
                cols = pa["columns_referenced"][:8]
                lines.append(f"\n**Columns:** {', '.join([f'`{c}`' for c in cols])}")

            # Join keys
            ja = a.get("join_analysis", {})
            if ja.get("join_keys"):
                lines.append("\n**Join keys:**")
                for jk in ja["join_keys"]:
                    lines.append(f"- `{jk['left']}` = `{jk['right']}`")

            # Group
            ga = a.get("group_analysis", {})
            if ga.get("group_keys"):
                lines.append(f"\n**Group by:** {', '.join([f'`{k}`' for k in ga['group_keys']])}")
            if ga.get("aggregations"):
                lines.append("**Aggregations:**")
                for agg in ga["aggregations"]:
                    lines.append(f"- `{agg['column']}`: {', '.join(agg['aggregations'])}")

            # Window
            wa = a.get("window_analysis", {})
            if wa.get("partition_by"):
                lines.append(f"\n**Partition by:** {', '.join([f'`{c}`' for c in wa['partition_by']])}")
            if wa.get("order_by"):
                lines.append(f"**Order by:** {', '.join([f'`{c}`' for c in wa['order_by']])}")

            lines.append("")

        return "\n".join(lines)

    def build_sql_md(all_recipes):
        lines = []
        lines.append("# ARIS SQL Summary")
        lines.append(f"\n**Project:** {PROJECT_KEY}")
        lines.append(f"**Generated:** {datetime.now().isoformat(timespec='seconds')}")
        lines.append(f"\n> All SQL recipe code in one file for LLM reference.")
        lines.append(f"> Give this to Claude or Copilot to answer questions about specific SQL logic.\n")

        sql_count = 0
        for recipe in all_recipes:
            rtype   = recipe.get("recipe_type", "")
            name    = recipe.get("recipe_name", "")
            payload = recipe.get("payload", "") or ""
            inputs  = recipe.get("inputs",  [])
            outputs = recipe.get("outputs", [])

            if rtype not in ("sql_query", "sql_script", "hive", "spark_sql"):
                continue
            if not payload:
                continue

            sql_count += 1
            lines.append(f"## {name}")
            lines.append(f"**Type:** {rtype}")
            lines.append(f"**Reads from:** {', '.join(inputs)}")
            lines.append(f"**Writes to:** {', '.join(outputs)}")
            lines.append(f"\n```sql\n{payload.strip()}\n```\n")

        lines.insert(4, f"**Total SQL recipes with code:** {sql_count}\n")
        return "\n".join(lines)

    code_md = build_code_md(code_intelligence)
    sql_md  = build_sql_md(recipes)

    # ----------------------------------------------------------
    # SAVE
    # ----------------------------------------------------------
    print("\nSaving outputs...")
    save_json(CODE_INTELLIGENCE_FILE, code_intelligence)
    save_json(COLUMN_INDEX_FILE,      column_index_output)
    save_text(CODE_INTELLIGENCE_MD,   code_md)
    save_text(SQL_SUMMARY_MD,         sql_md)

