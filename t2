def load_json(filename):
    path = output_path(filename)
    if not os.path.exists(path):
        raise FileNotFoundError(
            f"File not found: {path}\n"
            f"Run Phase 1 first: python phase1_scanner\\scanner.py"
        )
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def save_json(filename, data):
    path = output_path(filename)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, default=str)
    print(f"  [SAVED] {filename}")

def save_text(filename, text):
    path = output_path(filename)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    print(f"  [SAVED] {filename}")

def update_column_index(column_index, col, recipe_name, recipe_type, behavior):
    if not col:
        return
    if col not in column_index:
        column_index[col] = []
    column_index[col].append({
        "recipe":   recipe_name,
        "type":     recipe_type,
        "behavior": behavior
    })

# ============================================================
# SQL ANALYSER
# Generic - works for any SQL in any domain.
# ============================================================

RESERVED = {
    "SELECT", "FROM", "WHERE", "AND", "OR", "NOT", "AS", "ON",
    "JOIN", "LEFT", "RIGHT", "INNER", "OUTER", "FULL", "CROSS",
    "GROUP", "BY", "ORDER", "HAVING", "LIMIT", "UNION", "ALL",
    "CASE", "WHEN", "THEN", "ELSE", "END", "IN", "IS", "NULL",
    "LIKE", "BETWEEN", "EXISTS", "DISTINCT", "WITH", "TOP",
    "INSERT", "UPDATE", "DELETE", "CREATE", "DROP", "ALTER",
    "TRUE", "FALSE", "ASC", "DESC", "INTO", "VALUES", "SET"
}

def extract_columns_from_sql(sql_text):
    """
    Extract column usage from SQL text by clause type.
    Returns dict with classified column lists.
    """
    if not sql_text:
        return {}

    sql_upper = sql_text.upper()
    result = {
        "select_columns":    [],
        "where_columns":     [],
        "join_columns":      [],
        "group_columns":     [],
        "order_columns":     [],
        "case_columns":      [],
        "aggregate_columns": []
    }

    # --- AGGREGATE functions ---
    agg_pattern = r'(SUM|COUNT|AVG|MIN|MAX|COUNT_DISTINCT|MEDIAN|VARIANCE|STDDEV)\s*\(\s*(?:DISTINCT\s+)?([^)]+?)\s*\)'
    for m in re.finditer(agg_pattern, sql_upper):
        func = m.group(1)
        col  = m.group(2).strip().strip('"').strip("'").strip("`")
        if col and col not in ("*",) and col not in RESERVED:
            result["aggregate_columns"].append({"column": col, "function": func})

    # --- CASE WHEN columns ---
    for m in re.finditer(r'CASE\s+WHEN\s+"?([A-Z_][A-Z0-9_]*)"?', sql_upper):
        col = m.group(1)
        if col not in RESERVED:
            result["case_columns"].append(col)

    # --- SELECT clause columns ---
    select_match = re.search(r'SELECT\s+(.*?)\s+FROM\s', sql_upper, re.DOTALL)
    if select_match:
        select_text = select_match.group(1)

        # Renamed: SOMETHING AS ALIAS
        for m in re.finditer(
            r'"?([A-Z_][A-Z0-9_.]*)"?\s+AS\s+"?([A-Z_][A-Z0-9_]*)"?',
            select_text
        ):
            source = m.group(1).strip('"').strip("'")
            alias  = m.group(2)
            if alias not in RESERVED and source not in RESERVED:
                result["select_columns"].append({
                    "source":      source,
                    "alias":       alias,
                    "transformed": source.upper() != alias.upper()
                })

        # Direct column refs not already captured in AS
        for m in re.finditer(r'"([A-Z_][A-Z0-9_]*)"', select_text):
            col = m.group(1)
            already = any(
                c.get("source") == col or c.get("alias") == col
                for c in result["select_columns"]
            )
            if not already and col not in RESERVED:
                result["select_columns"].append({
                    "source":      col,
                    "alias":       col,
                    "transformed": False
                })

    # --- WHERE clause columns ---
    where_match = re.search(
        r'\bWHERE\b(.*?)(?:\bGROUP\s+BY\b|\bORDER\s+BY\b|\bHAVING\b|$)',
        sql_upper, re.DOTALL
    )
    if where_match:
        where_text = where_match.group(1)
        for m in re.finditer(
            r'"?([A-Z_][A-Z0-9_]*)"?\s*(?:=|!=|<>|>=|<=|>|<|\bIS\b|\bIN\b|\bLIKE\b|\bNOT\b)',
            where_text
        ):
            col = m.group(1)
            if col not in RESERVED:
                result["where_columns"].append(col)

    # --- GROUP BY columns ---
    group_match = re.search(
        r'\bGROUP\s+BY\b(.*?)(?:\bHAVING\b|\bORDER\s+BY\b|$)',
        sql_upper, re.DOTALL
    )
    if group_match:
        for m in re.finditer(r'"?([A-Z_][A-Z0-9_]*)"?', group_match.group(1)):
            col = m.group(1)
            if col not in RESERVED:
                result["group_columns"].append(col)

    # --- ORDER BY columns ---
    order_match = re.search(r'\bORDER\s+BY\b(.*?)$', sql_upper, re.DOTALL)
    if order_match:
        for m in re.finditer(r'"?([A-Z_][A-Z0-9_]*)"?', order_match.group(1)):
            col = m.group(1)
            if col not in RESERVED and col not in ("ASC", "DESC"):
                result["order_columns"].append(col)

    # --- JOIN key columns ---
    for m in re.finditer(
        r'\bON\b\s+"?([A-Z_][A-Z0-9_.]*)"?\s*=\s*"?([A-Z_][A-Z0-9_.]*)"?',
        sql_upper
    ):
        left  = m.group(1).split(".")[-1]
        right = m.group(2).split(".")[-1]
        if left  not in RESERVED: result["join_columns"].append(left)
        if right not in RESERVED: result["join_columns"].append(right)

    return result


# ============================================================
# JOIN RECIPE ANALYSER
# Reads Dataiku join recipe structure.
# Confirmed from Dataiku API source code and documentation.
# Join payload stored in recipe["joins"] and recipe["json_payload"]
# ============================================================

def analyze_join_recipe(recipe_data):
    """
    Extract join keys and selected columns from a Dataiku Join recipe.
    Reads from both recipe["joins"] (direct) and recipe["json_payload"].
    """
    result = {
        "join_type":        "unknown",
        "join_keys":        [],
        "left_input":       recipe_data.get("inputs", [None])[0],
        "right_inputs":     recipe_data.get("inputs", [])[1:],
        "outputs":          recipe_data.get("outputs", []),
        "selected_columns": []
    }

    # Method 1: joins array captured directly by Phase 1 scanner
    joins_direct = recipe_data.get("joins", [])
    if isinstance(joins_direct, list) and joins_direct:
        for join in joins_direct:
            if not isinstance(join, dict):
                continue
            jtype = join.get("type", "")
            if jtype:
                result["join_type"] = jtype
            for cond in join.get("on", []):
                if not isinstance(cond, dict):
                    continue
                col1  = cond.get("column1", {})
                col2  = cond.get("column2", {})
                left  = col1.get("name", "") if isinstance(col1, dict) else str(col1)
                right = col2.get("name", "") if isinstance(col2, dict) else str(col2)
                if left or right:
                    result["join_keys"].append({
                        "left":      left,
                        "right":     right,
                        "condition": cond.get("type", "EQ")
                    })

    # Method 2: json_payload (alternate / supplementary location)
    payload = recipe_data.get("json_payload", {})
    if isinstance(payload, dict):
        if result["join_type"] == "unknown":
            result["join_type"] = payload.get("joinType", "unknown")

        if not result["join_keys"]:
            for join in payload.get("joins", []):
                if not isinstance(join, dict):
                    continue
                for cond in join.get("on", []):
                    if not isinstance(cond, dict):
                        continue
                    col1  = cond.get("column1", {})
                    col2  = cond.get("column2", {})
                    left  = col1.get("name", "") if isinstance(col1, dict) else str(col1)
                    right = col2.get("name", "") if isinstance(col2, dict) else str(col2)
                    result["join_keys"].append({
                        "left":      left,
                        "right":     right,
                        "condition": "EQ"
                    })

        for col in payload.get("selectedColumns", []):
            if isinstance(col, dict) and col.get("name"):
                result["selected_columns"].append({
                    "name":  col["name"],
                    "table": col.get("tableReference", {}).get("table", ""),
                    "type":  col.get("type", "")
                })

    return result


# ============================================================
# PYTHON / PYSPARK ANALYSER
# Extracts column references and operations from Python code.
# ============================================================

def analyze_python_recipe(code_text):
    """
    Extract column references and Spark operations from Python/PySpark code.
    """
    if not code_text:
        return {"columns_referenced": [], "operations": []}

    result = {"columns_referenced": [], "operations": []}

    patterns = [
        r'df\s*\[["\'`]([^"\'`]+)["\'`]\]',
        r'\.select\s*\(\s*["\'`]([^"\'`]+)["\'`]',
        r'\.filter\s*\(\s*["\'`]([^"\'`]+)["\'`]',
        r'\.withColumn\s*\(\s*["\'`]([^"\'`]+)["\'`]',
        r'\.groupBy\s*\(\s*["\'`]([^"\'`]+)["\'`]',
        r'\bcol\s*\(\s*["\'`]([^"\'`]+)["\'`]\)',
        r'\bF\.col\s*\(\s*["\'`]([^"\'`]+)["\'`]\)',
        r'\.drop\s*\(\s*["\'`]([^"\'`]+)["\'`]\)',
        r'\.orderBy\s*\(\s*["\'`]([^"\'`]+)["\'`]\)',
        r'\.sort\s*\(\s*["\'`]([^"\'`]+)["\'`]\)',
    ]

    for pattern in patterns:
        for m in re.finditer(pattern, code_text, re.IGNORECASE):
            col = m.group(1).strip()
            if col and col not in result["columns_referenced"]:
                result["columns_referenced"].append(col)

    op_patterns = [
        (r'\.groupBy\s*\(',    "GROUP_BY"),
        (r'\.agg\s*\(',        "AGGREGATION"),
        (r'\.join\s*\(',       "JOIN"),
        (r'\.filter\s*\(',     "FILTER"),
        (r'\.where\s*\(',      "FILTER"),
        (r'\.withColumn\s*\(', "TRANSFORM"),
        (r'\.select\s*\(',     "SELECT"),
        (r'\.drop\s*\(',       "DROP"),
        (r'\.dropDuplicates\s*\(', "DEDUP"),
        (r'\.union\s*\(',      "UNION"),
        (r'\.distinct\s*\(',   "DISTINCT"),
        (r'\.orderBy\s*\(',    "ORDER"),
        (r'\.sort\s*\(',       "ORDER"),
        (r'\.fillna\s*\(',     "FILL_NA"),
        (r'\.fillNull\s*\(',   "FILL_NULL"),
        (r'\.pivot\s*\(',      "PIVOT"),
    ]

    for pattern, op_name in op_patterns:
        if re.search(pattern, code_text, re.IGNORECASE):
            if op_name not in result["operations"]:
                result["operations"].append(op_name)

    return result


# ============================================================
# GROUP / AGGREGATION RECIPE ANALYSER
# Confirmed from Dataiku docs:
# json_payload has "keys" (group by) and "values" (aggregations)
# ============================================================

def analyze_group_recipe(recipe_data):
    """
    Extract group keys and aggregations from a Dataiku Group recipe.
    """
    result = {
        "group_keys":   [],
        "aggregations": [],
        "all_columns":  []
    }

    payload = recipe_data.get("json_payload", {})
    if not isinstance(payload, dict):
        return result

    for key in payload.get("keys", []):
        if isinstance(key, dict):
            col = key.get("column", "")
            if col:
                result["group_keys"].append(col)
                result["all_columns"].append(col)

    agg_types = [
        "sum", "count", "avg", "min", "max",
        "stddev", "count_distinct", "first", "last",
        "median", "variance", "percentile25", "percentile75"
    ]
    for val in payload.get("values", []):
        if isinstance(val, dict):
            col  = val.get("column", "")
            aggs = [a.upper() for a in agg_types if val.get(a)]
            if col:
                result["aggregations"].append({
                    "column":       col,
                    "aggregations": aggs
                })
                result["all_columns"].append(col)

    return result


# ============================================================
# WINDOW RECIPE ANALYSER
# Confirmed from Dataiku WindowRecipeSettings docs.
# ============================================================

def analyze_window_recipe(recipe_data):
    """
    Extract partition, order, and window function columns
    from a Dataiku Window recipe.
    """
    result = {
        "partition_by":   [],
        "order_by":       [],
        "window_columns": [],
        "all_columns":    []
    }

    payload = recipe_data.get("json_payload", {})
    if not isinstance(payload, dict):
        return result

    win_def = payload.get("windowDefinitions", {})
    if isinstance(win_def, dict):
        for col in win_def.get("partitioning", []):
            if isinstance(col, dict):
                col_name = col.get("column", "")
                if col_name:
                    result["partition_by"].append(col_name)
                    result["all_columns"].append(col_name)

        for col in win_def.get("ordering", []):
            if isinstance(col, dict):
                col_name = col.get("column", "")
                if col_name:
                    result["order_by"].append(col_name)
                    result["all_columns"].append(col_name)

    for col in payload.get("computedColumns", []):
        if isinstance(col, dict):
            col_name = col.get("name", "")
            if col_name:
                result["window_columns"].append({
                    "name": col_name,
                    "mode": col.get("mode", "")
                })
                result["all_columns"].append(col_name)

    return result


