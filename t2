    for rt, count in sorted(recipe_type_counts.items()):
        print(f"  {rt:<25} : {count}")
    print()
    print("Column behavior distribution:")
    for behavior, count in sorted(behavior_counts.items(), key=lambda x: -x[1]):
        print(f"  {behavior:<20} : {count}")
    print()
    print("Top 10 columns (most widely used):")
    for col, count in top_columns[:10]:
        print(f"  {col:<35} : {count} recipe(s)")
    print()
    print(f"Output files in: {LOCAL_OUTPUT_DIR}\\")
    print(f"  [SAVED] {CODE_INTELLIGENCE_FILE}")
    print(f"  [SAVED] {CODE_INTELLIGENCE_MD}")
    print(f"  [SAVED] {COLUMN_INDEX_FILE}")
    print(f"  [SAVED] {SQL_SUMMARY_MD}")
    print()
    print("Give these files to Claude or Copilot:")
    print(f"  1. {CODE_INTELLIGENCE_MD}  -> how every recipe works")
    print(f"  2. {SQL_SUMMARY_MD}        -> all actual SQL code")
    print(f"  3. {OUTPUT_PREFIX}DESIGN_CONTEXT.md -> Visio business rules")
    print()
    print("Ask questions like:")
