# ==========================================================================
# STEP 4 - PYTHON RECIPE CLASSIFICATION
#
# For Python/PySpark recipes — search the code text for attribute references.
# Less precise than SQL parsing but captures obvious patterns.
# ==========================================================================

def classify_attribute_in_python(recipe_data, attribute):
    """
    Classify how an attribute behaves in a Python or PySpark recipe.
    Searches for column references in the code.
    """
    code = recipe_data.get("code", "")
    payload = recipe_data.get("payload", "")

    # Use whichever has content
    code_text = code if code else payload
    if not code_text:
        return {
            "classification": "UNKNOWN",
            "confidence": "LOW",
            "evidence": None,
            "notes": "No Python code available to analyse."
        }

    attr_upper = attribute.upper()
    code_upper = code_text.upper()

    if attr_upper not in code_upper:
        return {
            "classification": "NOT_FOUND",
            "confidence": "MEDIUM",
            "evidence": None,
            "notes": f"'{attribute}' not referenced in Python code."
        }

    # Find the line containing the attribute
    for line in code_text.split("\n"):
        if attr_upper in line.upper():
            evidence_line = line.strip()
            break
    else:
        evidence_line = f"Found '{attribute}' in code"

    # Check for groupby/aggregation
    if any(agg in code_upper for agg in ["GROUPBY", "GROUP_BY", ".SUM(", ".COUNT(", ".AGG("]):
        if attr_upper in code_upper:
            return {
                "classification": "AGGREGATED",
                "confidence": "MEDIUM",
                "evidence": evidence_line,
                "notes": f"'{attribute}' may be involved in a groupby/aggregation. Manual review recommended."
            }

    # Check for rename/alias
    if any(pattern in code_upper for pattern in [f'RENAME({attr_upper}', f'"{attr_upper}":', f"'{attr_upper}'"]):
        return {
            "classification": "TRANSFORMED",
            "confidence": "MEDIUM",
            "evidence": evidence_line,
            "notes": f"'{attribute}' appears in a rename or mapping context."
        }

    # General reference
    return {
        "classification": "REFERENCED",
        "confidence": "LOW",
        "evidence": evidence_line,
        "notes": f"'{attribute}' is referenced in Python code. Manual review recommended for exact behavior."
    }

