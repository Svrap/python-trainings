def build_transformation_report(data):
    lines = []

    lines.append("# ARIS Transformation Intelligence Report")
    lines.append(f"\n**Project:** {data['project']}")
    lines.append(f"**Generated:** {data['generated_at']}")
    lines.append(f"**Attributes analysed:** {', '.join(data['search_terms'])}")
    lines.append(f"**Recipes analysed:** {data['recipes_analysed']}")

    # Warnings first
    if data["manual_review_needed"]:
        lines.append("\n---\n")
        lines.append("## ⚠️ Recipes Requiring Manual Review\n")
        lines.append("These recipes could not be classified with high confidence:")
        lines.append("")
        lines.append("| Recipe | Attribute | Reason |")
        lines.append("|---|---|---|")
        for item in data["manual_review_needed"]:
            lines.append(f"| {item['recipe']} | {item['attribute']} | {item['reason'][:80]} |")

    # Classification summary per attribute
    lines.append("\n---\n")
    lines.append("## Classification Summary\n")

    for term, counts in data["classification_summary"].items():
        lines.append(f"### Attribute: `{term}`\n")
        lines.append("| Classification | Recipe Count |")
        lines.append("|---|---|")
        for cls, count in sorted(counts.items(), key=lambda x: -x[1]):
            lines.append(f"| {cls} | {count} |")
        lines.append("")

    # Per-recipe detail
    lines.append("\n---\n")
    lines.append("## Recipe-Level Classification Detail\n")

    for recipe_name, result in data["recipe_classifications"].items():

        if "error" in result:
            lines.append(f"### ❌ {recipe_name}")
            lines.append(f"Error: {result['error']}\n")
            continue

        lines.append(f"### {recipe_name}")
        lines.append(f"**Type:** {result['recipe_type']} | "
                     f"**Inputs:** {', '.join(result['inputs'])} | "
                     f"**Outputs:** {', '.join(result['outputs'])}\n")

        lines.append("| Attribute | Classification | Confidence | Evidence |")
        lines.append("|---|---|---|---|")

        for term, attr_result in result["attributes"].items():
            cls = attr_result.get("classification", "UNKNOWN")
            conf = attr_result.get("confidence", "LOW")
            evidence = (attr_result.get("evidence") or "")[:60]
            lines.append(f"| {term} | **{cls}** | {conf} | `{evidence}` |")

        # Notes
        for term, attr_result in result["attributes"].items():
            note = attr_result.get("notes", "")
            if note:
                lines.append(f"\n> **{term}:** {note}")

        lines.append("")

    # Classification legend
    lines.append("\n---\n")
    lines.append("## Classification Reference\n")
    lines.append("| Classification | Meaning | Action Required |")
    lines.append("|---|---|---|")
    lines.append("| PASSTHROUGH | Column flows through unchanged | Verify output schema includes column |")
    lines.append("| TRANSFORMED | Column renamed or modified | Check new name propagates correctly |")
    lines.append("| CALCULATED | Derived from logic/arithmetic | Check source columns are available |")
    lines.append("| AGGREGATED | Grouped/aggregated | Check GROUP BY logic still valid |")
    lines.append("| JOIN_KEY | Used in join condition | Ensure join key is present in both sides |")
    lines.append("| FILTER_RULE | In WHERE clause only | No output change needed |")
    lines.append("| NOT_FOUND | Not in this recipe | No action needed |")
    lines.append("| REFERENCED | Unclear role | Manual review required |")
    lines.append("| UNKNOWN | Cannot determine | Manual review required |")

    lines.append("\n---\n")
    lines.append("## Next Step\n")
    lines.append("Run **ARIS Phase 4 — Implementation Scope** to generate")
    lines.append("work items, suggested code changes, and test plans.")

    return "\n".join(lines)

markdown_report = build_transformation_report(transformation_analysis_json)

