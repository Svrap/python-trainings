print("\nClassifying attribute behavior in impacted recipes...")

classification_results = {}
success_count = 0
error_count = 0

for index, recipe_name in enumerate(sorted(all_impacted_recipes)):

    print(f"  [{index+1}/{len(all_impacted_recipes)}] {recipe_name[:60]:<60}", end="\r")

    recipe_data = recipes_map.get(recipe_name)

    if not recipe_data:
        error_count += 1
        classification_results[recipe_name] = {
            "recipe_name": recipe_name,
            "recipe_type": "UNKNOWN",
            "error": "Recipe not found in Phase 1 intelligence",
            "attributes": {}
        }
        continue

    recipe_type = recipe_data.get("recipe_type", "unknown")
    recipe_result = {
        "recipe_name": recipe_name,
        "recipe_type": recipe_type,
        "inputs": recipe_data.get("inputs", []),
        "outputs": recipe_data.get("outputs", []),
        "attributes": {}
    }

    # Classify each search term in this recipe
    for term in search_terms:

        if recipe_type in ("sql_query", "sql_script", "hive", "spark_sql"):
            # SQL recipe — use SQL classifier
            sql_text = recipe_data.get("payload", "") or recipe_data.get("generated_sql", "")
            classification = classify_attribute_in_sql(sql_text, term)

        elif recipe_type == "join":
            # Join recipe — use join classifier
            classification = classify_attribute_in_join(recipe_data, term)

        elif recipe_type in ("python", "pyspark", "r"):
            # Code recipe — use Python classifier
            classification = classify_attribute_in_python(recipe_data, term)

        else:
            # Unknown recipe type
            classification = {
                "classification": "UNKNOWN",
                "confidence": "LOW",
                "evidence": None,
                "notes": f"Recipe type '{recipe_type}' — manual review required."
            }

        recipe_result["attributes"][term] = classification

    classification_results[recipe_name] = recipe_result
    success_count += 1

print(f"\n✅ Classified: {success_count} recipes | ⚠️ Errors: {error_count}")

