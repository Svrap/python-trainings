# STEP 2 - SQL CLASSIFICATION ENGINE
#
# Reads the SQL payload and classifies how an attribute behaves.
# Uses regex pattern matching on the SQL text.
# Case-insensitive throughout.
# ==========================================================================

def classify_attribute_in_sql(sql_text, attribute):
    """
    Classify how an attribute behaves in a SQL recipe.

    Returns a dict with:
      - classification: the primary classification string
      - confidence: HIGH / MEDIUM / LOW
      - evidence: the matching SQL snippet that led to classification
      - notes: human-readable explanation
    """
    if not sql_text or not attribute:
        return {
            "classification": "UNKNOWN",
            "confidence": "LOW",
            "evidence": None,
            "notes": "No SQL text available to analyse."
        }

    sql_upper = sql_text.upper().strip()
    attr_upper = attribute.upper().strip()

    # Attribute not mentioned at all
    if attr_upper not in sql_upper:
        return {
            "classification": "NOT_FOUND",
            "confidence": "HIGH",
            "evidence": None,
            "notes": f"'{attribute}' does not appear anywhere in this recipe's SQL."
        }

    # ------------------------------------------------------------------
    # 1. AGGREGATED
    # Pattern: SUM(attr), COUNT(attr), AVG(attr), MIN(attr), MAX(attr)
    # ------------------------------------------------------------------
    agg_pattern = rf"(SUM|COUNT|AVG|MIN|MAX|COUNT_DISTINCT)\s*\(\s*[^\)]*{attr_upper}[^\)]*\)"
    agg_match = re.search(agg_pattern, sql_upper)
    if agg_match:
        snippet = sql_upper[max(0, agg_match.start()-20):agg_match.end()+20]
        return {
            "classification": "AGGREGATED",
            "confidence": "HIGH",
            "evidence": snippet.strip(),
            "notes": f"'{attribute}' is aggregated using {agg_match.group(1)}()."
        }

    # ------------------------------------------------------------------
    # 2. TRANSFORMED — renamed: ORIGINAL_NAME AS ALIAS
    # Pattern: something AS attribute or attribute AS something_else
    # ------------------------------------------------------------------
    # Case: another_col AS BRAND  (incoming rename — attribute is output name)
    as_to_attr = rf"\w+\s+AS\s+{attr_upper}[\s,\n]"
    as_match = re.search(as_to_attr, sql_upper)
    if as_match:
        snippet = sql_upper[max(0, as_match.start()-10):as_match.end()+10]
        return {
            "classification": "TRANSFORMED",
            "confidence": "HIGH",
            "evidence": snippet.strip(),
            "notes": f"'{attribute}' is the output name of a renamed column (X AS {attribute})."
        }

    # Case: BRAND AS something_else (attribute renamed outward)
    attr_as_other = rf"{attr_upper}\s+AS\s+\w+"
    attr_as_match = re.search(attr_as_other, sql_upper)
    if attr_as_match:
        snippet = sql_upper[max(0, attr_as_match.start()-10):attr_as_match.end()+10]
        return {
            "classification": "TRANSFORMED",
            "confidence": "HIGH",
            "evidence": snippet.strip(),
            "notes": f"'{attribute}' is renamed to another column name in output."
        }

    # ------------------------------------------------------------------
    # 3. CALCULATED — CASE WHEN or arithmetic involving the attribute
    # ------------------------------------------------------------------
    # Check if attribute appears in a CASE WHEN block
    case_pattern = rf"CASE\s+WHEN[^E]*{attr_upper}[^E]*END"
    case_match = re.search(case_pattern, sql_upper, re.DOTALL)
    if case_match:
        snippet = sql_upper[max(0, case_match.start()):case_match.start()+80]
        return {
            "classification": "CALCULATED",
            "confidence": "HIGH",
            "evidence": snippet.strip(),
            "notes": f"'{attribute}' is used inside a CASE WHEN expression."
        }

    # Check arithmetic operations involving attribute
    arithmetic_pattern = rf"{attr_upper}\s*[\+\-\*\/]|[\+\-\*\/]\s*{attr_upper}"
    arith_match = re.search(arithmetic_pattern, sql_upper)
    if arith_match:
        snippet = sql_upper[max(0, arith_match.start()-15):arith_match.end()+15]
        return {
            "classification": "CALCULATED",
            "confidence": "HIGH",
            "evidence": snippet.strip(),
            "notes": f"'{attribute}' is used in an arithmetic calculation."
        }

    # ------------------------------------------------------------------
    # 4. FILTER_RULE — attribute only in WHERE or HAVING clause
    # ------------------------------------------------------------------
    # Split SQL into SELECT and WHERE parts
    where_split = re.split(r'\bWHERE\b|\bHAVING\b', sql_upper, maxsplit=1, flags=re.IGNORECASE)
    select_part = where_split[0]
    where_part = where_split[1] if len(where_split) > 1 else ""

    attr_in_select = attr_upper in select_part
    attr_in_where = attr_upper in where_part

    if attr_in_where and not attr_in_select:
        # Find the WHERE clause evidence
        where_idx = sql_upper.find(attr_upper, len(select_part))
        snippet = sql_upper[max(0, where_idx-20):where_idx+40]
        return {
            "classification": "FILTER_RULE",
            "confidence": "HIGH",
            "evidence": snippet.strip(),
            "notes": f"'{attribute}' appears only in WHERE/HAVING clause — not selected in output."
        }

    # ------------------------------------------------------------------
    # 5. PASSTHROUGH — attribute in SELECT as-is (no transformation)
    # ------------------------------------------------------------------
    if attr_in_select:
        # Check for SELECT * (all columns pass through)
        if "SELECT *" in select_part or "SELECT\n*" in select_part:
            return {
                "classification": "PASSTHROUGH",
                "confidence": "MEDIUM",
                "evidence": "SELECT *",
                "notes": f"Recipe uses SELECT * — '{attribute}' passes through if present in source."
            }

        # Direct SELECT: column appears in SELECT clause directly
        # Pattern: comma or SELECT at start, then attribute, then comma or FROM
        direct_select = rf"(?:SELECT|,)\s*[\"\`]?{attr_upper}[\"\`]?\s*(?:,|\n|FROM)"
        direct_match = re.search(direct_select, select_part)
        if direct_match:
            snippet = select_part[max(0, direct_match.start()):direct_match.end()+10]
            return {
                "classification": "PASSTHROUGH",
                "confidence": "HIGH",
                "evidence": snippet.strip(),
                "notes": f"'{attribute}' is selected directly without transformation."
            }

        # Attribute in SELECT but pattern not matched clearly
        return {
            "classification": "PASSTHROUGH",
            "confidence": "MEDIUM",
            "evidence": f"Found '{attribute}' in SELECT portion",
            "notes": f"'{attribute}' appears in SELECT clause — likely passed through."
        }

    # ------------------------------------------------------------------
    # 6. REFERENCED — attribute appears but not clearly classified
    # ------------------------------------------------------------------
    return {
        "classification": "REFERENCED",
        "confidence": "LOW",
        "evidence": f"'{attribute}' found in SQL but classification unclear",
        "notes": f"'{attribute}' appears in the recipe but its exact role could not be determined. Manual review recommended."
    }

