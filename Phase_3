# STEP 3 - JOIN RECIPE CLASSIFICATION
#
# Join recipes don't have SQL — they have join configuration.
# We check if attribute is used as a join key.
# ==========================================================================

def classify_attribute_in_join(recipe_data, attribute):
    """
    Classify how an attribute behaves in a Join recipe.
    Checks join key configuration.
    """
    attr_upper = attribute.upper()

    # Check joins array
    joins = recipe_data.get("joins", [])
    for join in joins:
        # Join key conditions
        conditions = join.get("on", []) if isinstance(join, dict) else []
        for condition in conditions:
            left_col = str(condition.get("column1", {}).get("name", "")).upper()
            right_col = str(condition.get("column2", {}).get("name", "")).upper()
            if attr_upper in left_col or attr_upper in right_col:
                return {
                    "classification": "JOIN_KEY",
                    "confidence": "HIGH",
                    "evidence": f"Join condition: {condition}",
                    "notes": f"'{attribute}' is used as a join key in this Join recipe."
                }

    # Check json_payload for selected columns
    json_payload = recipe_data.get("json_payload", {})
    if json_payload and isinstance(json_payload, dict):
        selected_columns = json_payload.get("selectedColumns", [])
        for col_entry in selected_columns:
            col_name = str(col_entry.get("name", "")).upper()
            if attr_upper in col_name:
                return {
                    "classification": "PASSTHROUGH",
                    "confidence": "MEDIUM",
                    "evidence": f"Column selected: {col_entry.get('name')}",
                    "notes": f"'{attribute}' is included in the Join recipe output columns."
                }

    # Attribute not found in join config
    return {
        "classification": "NOT_FOUND",
        "confidence": "MEDIUM",
        "evidence": None,
        "notes": f"'{attribute}' not found in Join recipe configuration. May be implicitly included."
    }

