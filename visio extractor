# BUILD OUTPUTS
# Pure extraction output. No SQL. No interpretation.
# LLM reads this and understands the flow.
# ============================================================

def build_json_output(flow, project_key, source_file, flow_name):
    """Build clean JSON output from extracted flow."""

    ARIS_METADATA = {
        "aris_version":  "1.0",
        "phase":         "Visio Extractor",
        "project":       project_key,
        "generated_at":  datetime.now().isoformat(timespec="seconds"),
        "source_file":   source_file,
        "source_type":   flow.get("source_type", "unknown"),
        "flow_name":     flow_name
    }

    return {
        **ARIS_METADATA,
        "document_info":   flow.get("document_info", {}),
        "pages":           flow.get("pages", []),
        "flow_summary": {
            "total_pages":     len(flow.get("pages", [])),
            "total_decisions": len(flow.get("decisions", [])),
            "total_processes": len(flow.get("processes", [])),
            "total_end_states":len(flow.get("end_states", [])),
            "total_connectors":len(flow.get("connectors", [])),
            "unknown_shapes":  len(flow.get("unknown_shapes", [])),
            "source_type":     flow.get("source_type", "unknown"),
            "accuracy_note":   (
                "High accuracy - shape types from Visio master names"
                if flow.get("source_type") == "vsdx"
                else "Medium accuracy - shape types inferred from text (PDF fallback)"
            )
        },
        "campaign_metadata": flow.get("metadata", []),
        "decision_rules":    flow.get("decisions", []),
        "process_steps":     flow.get("processes", []),
        "end_states":        flow.get("end_states", []),
        "connectors":        flow.get("connectors", []),
        "notes":             flow.get("notes", []),
        "unknown_shapes":    flow.get("unknown_shapes", []),
        "warning":           flow.get("warning", "")
    }


def build_markdown_output(data):
    """
    Build human-readable markdown.
    Clean, structured, ready for LLM consumption.
    No SQL. No interpretation. Just what the Visio says.
    """
    lines = []

    lines.append("# ARIS Design Context")
    lines.append(f"\n**Project:** {data['project']}")
    lines.append(f"**Flow:** {data['flow_name']}")
    lines.append(f"**Source:** {data['source_file']} ({data['source_type']})")
    lines.append(f"**Generated:** {data['generated_at']}")

    if data.get("warning"):
        lines.append(f"\n> [WARNING] {data['warning']}")

    # Document info
    doc_info = data.get("document_info", {})
    if any(v for v in doc_info.values()):
        lines.append("\n---\n## Document Information\n")
        for key, val in doc_info.items():
            if val:
                lines.append(f"- **{key.replace('_', ' ').title()}:** {val}")

    # Campaign metadata from START shapes
    if data.get("campaign_metadata"):
        lines.append("\n---\n## Campaign / Flow Metadata\n")
        lines.append("> Extracted from start shapes at top of Visio diagram\n")
        for item in data["campaign_metadata"]:
            lines.append(f"- {item}")

    # Flow summary
    summary = data["flow_summary"]
    lines.append("\n---\n## Flow Summary\n")
    lines.append("| Metric | Value |")
    lines.append("|---|---|")
    lines.append(f"| Source type | {summary['source_type']} |")
    lines.append(f"| Accuracy | {summary['accuracy_note']} |")
    lines.append(f"| Decision rules (diamonds) | {summary['total_decisions']} |")
    lines.append(f"| Process steps (rectangles) | {summary['total_processes']} |")
    lines.append(f"| End states (hexagons) | {summary['total_end_states']} |")
    lines.append(f"| Connectors traced | {summary['total_connectors']} |")
    if summary["unknown_shapes"] > 0:
        lines.append(f"| Unclassified shapes | {summary['unknown_shapes']} (review manually) |")

    # Decision rules — the core content
    lines.append("\n---\n## Business Rules\n")
    lines.append("> These are the exact filter conditions from the Visio decision diamonds.")
    lines.append("> Order is top to bottom as they appear in the diagram.")
    lines.append("> YES/NO paths show where each branch leads.\n")

    decisions = data.get("decision_rules", [])
    if not decisions:
        lines.append("_No decision rules found. Check unknown_shapes in JSON for unclassified content._")
    else:
        for decision in decisions:
            step = decision.get("step_number", "?")
            text = decision.get("text", decision.get("condition", ""))
            yes  = decision.get("yes_path", {})
            no   = decision.get("no_path", {})

            yes_action = yes.get("action", "unknown")
            yes_target = yes.get("target_text", "")
            no_action  = no.get("action", "unknown")
            no_target  = no.get("target_text", "")

            lines.append(f"### Rule {step}: {text}\n")
            lines.append(f"| Path | Action | Leads To |")
            lines.append(f"|---|---|---|")
            lines.append(f"| YES | {yes_action} | {yes_target or 'see diagram'} |")
            lines.append(f"| NO  | {no_action}  | {no_target  or 'see diagram'} |")

            master = decision.get("master_name", "")
            if master and master != "inferred_from_text":
                lines.append(f"\n_Shape master: {master}_\n")
            else:
                lines.append("")

    # Process steps
    processes = data.get("process_steps", [])
    if processes:
        lines.append("\n---\n## Process Steps\n")
        lines.append("> Action steps from rectangular shapes in the Visio diagram.\n")
        for i, proc in enumerate(processes, 1):
            text = proc.get("text", proc.get("action", ""))
            lines.append(f"{i}. {text}")

    # End states
    end_states = data.get("end_states", [])
    if end_states:
        lines.append("\n---\n## End States\n")
        for state in end_states:
            lines.append(f"- {state}")

    # Unknown shapes
    unknowns = data.get("unknown_shapes", [])
    if unknowns:
        lines.append("\n---\n## Unclassified Shapes\n")
        lines.append("> These shapes could not be classified automatically.")
        lines.append("> Review manually and add to correct section if needed.\n")
        for shape in unknowns:
            text = shape.get("text", "")
            lines.append(f"- {text}")

    # Notes
    notes = data.get("notes", [])
    if notes:
        lines.append("\n---\n## Notes and Legends\n")
        lines.append("> Extracted from information boxes and outside-flow text.\n")
        for note in notes[:20]:  # limit to first 20
            lines.append(f"- {note}")

    # How to use with LLM
    lines.append("\n---\n## How to Use This File With LLM\n")
    lines.append("Give this file to Claude or Copilot alongside the ARIS recipe intelligence files.")
    lines.append("Ask questions like:\n")
    lines.append('- "Which recipes implement Rule 1 (email check)? Show me the SQL."')
    lines.append('- "Is the state suppression rule in Rule 2 implemented in the pipeline?"')
    lines.append('- "What column name does Rule 3 map to in the actual recipe code?"')
    lines.append('- "Are all business rules from this Visio implemented in the data pipeline?"')
    lines.append('- "Generate a WHERE clause for Rule 1 based on the actual dataset columns."')

    return "\n".join(lines)


