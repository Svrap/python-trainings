# ============================================================
# SHAPE MASTER NAME LISTS
# These are standard Visio master shape names.
# Works for any Visio file from any domain.
# ============================================================

DECISION_MASTERS = [
    "decision", "diamond", "rhombus",
    "decision2", "conditional", "gateway"
]

PROCESS_MASTERS = [
    "process", "rectangle", "box", "task",
    "action", "step", "activity", "subprocess"
]

START_MASTERS = [
    "start", "terminator", "rounded rectangle",
    "begin", "trigger", "oval", "start 1",
    "start 2", "initiation"
]

END_MASTERS = [
    "end", "terminator", "stop", "finish",
    "terminal", "end 1", "end 2"
]

# ============================================================
# SHAPE CLASSIFIER
# Uses Visio master shape name first (most reliable).
# Falls back to text analysis if master name not available.
# Works for any Visio diagram from any domain.
# ============================================================

def classify_shape_by_master(master_name, shape_text):
    """
    Classify a shape using its Visio master name.
    Returns: DECISION, PROCESS, START, END, CONNECTOR, or NOTES
    """
    name = master_name.lower().strip()
    text = shape_text.upper().strip()

    if any(m in name for m in DECISION_MASTERS):
        return "DECISION"
    if any(m in name for m in PROCESS_MASTERS):
        return "PROCESS"
    if any(m in name for m in START_MASTERS):
        return "START"
    if any(m in name for m in END_MASTERS):
        return "END"

    return None  # unknown from master name alone


def classify_shape_by_text(shape_text):
    """
    Fallback classifier using shape text when master name unavailable.
    Looks for structural patterns not domain-specific keywords.
    """
    text = shape_text.strip()
    text_upper = text.upper()
    word_count = len(text.split())

    # End states
    if text_upper in ("STOP", "END", "FINISH", "DONE", "EXIT",
                      "ELIGIBLE", "NOT ELIGIBLE", "SUPPRESSED",
                      "EXCLUDED", "INCLUDED"):
        return "END"

    # Decision nodes — structural signal is the question mark
    if "?" in text:
        return "DECISION"

    # Short text (1-2 words) alone is likely a connector label or end state
    if word_count <= 2:
        if text_upper in ("YES", "NO", "Y", "N"):
            return "CONNECTOR_LABEL"
        return "NOTES"

    # Multi-word text is likely a process step or decision
    # Cannot distinguish reliably without master name
    return "UNKNOWN"


def get_shape_type(shape):
    """
    Get shape type for a vsdx shape object.
    Tries master name first then falls back to text.
    """
    master_name = ""
    shape_text  = (shape.text or "").strip()

    try:
        if shape.master_shape and shape.master_shape.name:
            master_name = shape.master_shape.name
    except Exception:
        pass

    if not master_name:
        try:
            if shape.master_page and shape.master_page.name:
                master_name = shape.master_page.name
        except Exception:
            pass

    # Try master name classification first
    if master_name:
        result = classify_shape_by_master(master_name, shape_text)
        if result:
            return result, master_name

    # Fallback to text classification
    return classify_shape_by_text(shape_text), master_name


# ============================================================
# VSDX EXTRACTOR
# Reads .vsdx file natively using vsdx library.
# Extracts shapes, connectors, document properties.
# ============================================================

def extract_from_vsdx(file_path):
    """
    Extract complete flow from a .vsdx Visio file.
    Returns structured flow dict.
    """
    try:
        import vsdx
    except ImportError:
        print("[ERROR] vsdx library not installed.")
        print("   Run: pip install vsdx")
        return None

    flow = {
        "source_type":     "vsdx",
        "source_file":     os.path.basename(file_path),
        "pages":           [],
        "document_info":   {},
        "metadata":        [],
        "decisions":       [],
        "processes":       [],
        "end_states":      [],
        "connectors":      [],
        "notes":           [],
        "unknown_shapes":  []
    }

    with vsdx.VisioFile(file_path) as vis:

        # Extract document properties
        try:
            props = vis.document_properties
            flow["document_info"] = {
                "title":    getattr(props, "title",    "") or "",
                "creator":  getattr(props, "creator",  "") or "",
                "company":  getattr(props, "company",  "") or "",
                "subject":  getattr(props, "subject",  "") or "",
                "keywords": getattr(props, "keywords", "") or "",
                "created":  getattr(props, "created",  "") or "",
                "modified": getattr(props, "modified", "") or ""
            }
        except Exception:
            pass

        # Process all pages
        for page_index, page in enumerate(vis.pages):

            page_info = {
                "page_number": page_index + 1,
                "page_name":   page.name or f"Page {page_index + 1}",
                "shape_count": len(page.shapes)
            }
            flow["pages"].append(page_info)

            print(f"  Page {page_index + 1}: {page_info['page_name']} "
                  f"({page_info['shape_count']} shapes)")

            shape_map = {}

            for shape in page.shapes:

                shape_id   = str(shape.shape_id)
                shape_text = (shape.text or "").strip()

                if not shape_text:
                    continue

                shape_type, master_name = get_shape_type(shape)

                # Get position
                try:
                    x_pos = float(shape.x or 0)
                    y_pos = float(shape.y or 0)
                    width  = float(shape.width  or 0)
                    height = float(shape.height or 0)
                except Exception:
                    x_pos  = 0
                    y_pos  = 0
                    width   = 0
                    height  = 0

                shape_record = {
                    "id":          shape_id,
                    "text":        shape_text,
                    "shape_type":  shape_type,
                    "master_name": master_name,
                    "x":           x_pos,
                    "y":           y_pos,
                    "width":       width,
                    "height":      height,
                    "page":        page_index + 1
                }

                shape_map[shape_id] = shape_record

                if shape_type == "START":
                    flow["metadata"].append(shape_text)

                elif shape_type == "DECISION":
                    flow["decisions"].append({
                        **shape_record,
                        "step_number": 0,
                        "yes_path":    {"action": "unknown", "target_text": "", "target_id": ""},
                        "no_path":     {"action": "unknown", "target_text": "", "target_id": ""}
                    })

                elif shape_type == "PROCESS":
                    flow["processes"].append(shape_record)

                elif shape_type == "END":
                    flow["end_states"].append(shape_text)

                elif shape_type == "CONNECTOR_LABEL":
                    pass  # handled via page.connects below

                elif shape_type == "NOTES":
                    flow["notes"].append(shape_text)

                else:
                    flow["unknown_shapes"].append(shape_record)

            # Extract connectors and trace YES/NO paths
            try:
                for connect in page.connects:
                    try:
                        from_id = str(connect.from_id)
                        to_id   = str(connect.to_id)
                        label   = (connect.label or "").strip()

                        flow["connectors"].append({
                            "from_shape_id":   from_id,
                            "to_shape_id":     to_id,
                            "label":           label,
                            "from_shape_text": shape_map.get(from_id, {}).get("text", ""),
                            "to_shape_text":   shape_map.get(to_id,   {}).get("text", "")
                        })

                        label_upper = label.upper()

                        for decision in flow["decisions"]:
                            if decision["id"] == from_id:
                                to_shape = shape_map.get(to_id, {})
                                to_type  = to_shape.get("shape_type", "")
                                to_text  = to_shape.get("text", to_id)
                                action   = "exclude" if to_type == "END" else "continue"

                                if label_upper == "YES":
                                    decision["yes_path"] = {
                                        "action":      action,
                                        "target_text": to_text,
                                        "target_id":   to_id
                                    }
                                elif label_upper == "NO":
                                    decision["no_path"] = {
                                        "action":      action,
                                        "target_text": to_text,
                                        "target_id":   to_id
                                    }

                    except Exception:
                        pass
            except Exception:
                pass

    # Sort decisions top to bottom
    # Visio Y axis: higher Y = higher on page
    flow["decisions"].sort(key=lambda d: -d.get("y", 0))

    for i, decision in enumerate(flow["decisions"]):
        decision["step_number"] = i + 1

    # Sort processes top to bottom too
    flow["processes"].sort(key=lambda p: -p.get("y", 0))

    return flow


# ============================================================
# PDF EXTRACTOR (FALLBACK)
# Uses PyMuPDF for better text extraction than pdfplumber.
# Less accurate than vsdx but better than nothing.
# ============================================================

def deduplicate_block(text):
    """Remove duplicate word patterns caused by PDF rendering layers."""
    if not text:
        return text
    words = text.strip().split()
    if len(words) <= 1:
        return text
    half = len(words) // 2
    if len(words) % 2 == 0:
        if words[:half] == words[half:]:
            return " ".join(words[:half])
    result = [words[0]]
    for i in range(1, len(words)):
        if words[i] != words[i - 1]:
            result.append(words[i])
    return " ".join(result)


def extract_from_pdf(file_path):
    """
    Extract flow from a PDF file using PyMuPDF.
    Less accurate than vsdx - cannot read shape types directly.
    Falls back to text-based classification.
    """
    try:
        import fitz
    except ImportError:
        print("[ERROR] PyMuPDF not installed.")
        print("   Run: pip install pymupdf")
        return None

    flow = {
        "source_type":    "pdf",
        "source_file":    os.path.basename(file_path),
        "pages":          [],
        "document_info":  {},
        "metadata":       [],
        "decisions":      [],
        "processes":      [],
        "end_states":     [],
        "connectors":     [],
        "notes":          [],
        "unknown_shapes": [],
        "warning":        "PDF extraction is less accurate than .vsdx. "
                          "Shape types inferred from text, not Visio master shapes."
    }

    doc = fitz.open(file_path)

    # Extract document metadata
    meta = doc.metadata or {}
    flow["document_info"] = {
        "title":    meta.get("title",    ""),
        "creator":  meta.get("creator",  ""),
        "subject":  meta.get("subject",  ""),
        "keywords": meta.get("keywords", ""),
        "created":  meta.get("creationDate", ""),
        "modified": meta.get("modDate",  "")
    }

    all_blocks = []

    for page_num, page in enumerate(doc):

        page_info = {
            "page_number": page_num + 1,
            "page_name":   f"Page {page_num + 1}",
            "width":       page.rect.width,
            "height":      page.rect.height
        }
        flow["pages"].append(page_info)

        data = page.get_text(
            "dict",
            flags=fitz.TEXT_DEHYPHENATE | fitz.TEXT_PRESERVE_WHITESPACE,
            sort=True
        )

        for block in data.get("blocks", []):
            if block.get("type") != 0:
                continue

            for line in block.get("lines", []):
                line_text = ""
                x0 = y0 = x1 = y1 = None

                for span in line.get("spans", []):
                    span_text = span.get("text", "").strip()
                    if not span_text:
                        continue
                    line_text += (" " + span_text) if line_text else span_text
                    bbox = span.get("bbox", [0, 0, 0, 0])
                    if x0 is None:
                        x0 = bbox[0]
                        y0 = bbox[1]
                    x1 = bbox[2]
                    y1 = bbox[3]

                line_text = deduplicate_block(line_text.strip())
                if line_text and x0 is not None:
                    all_blocks.append({
                        "text":     line_text,
                        "x0":       x0,
                        "y0":       y0,
                        "x1":       x1,
                        "y1":       y1,
                        "center_x": (x0 + x1) / 2,
                        "center_y": (y0 + y1) / 2,
                        "page":     page_num
                    })

    doc.close()

    all_blocks.sort(key=lambda b: (b["page"], b["y0"]))

    # Get page bounds for relative positioning
    all_y   = [b["y0"] for b in all_blocks] or [0, 1000]
    min_y   = min(all_y)
    max_y   = max(all_y)
    page_h  = max_y - min_y or 1

    step_counter = 0

    for block in all_blocks:
        text       = block["text"].strip()
        text_upper = text.upper()
        rel_y      = (block["y0"] - min_y) / page_h

        if not text:
            continue

        # Connector labels
        if text_upper in ("YES", "NO", "Y", "N"):
            flow["connectors"].append({
                "label":     text,
                "y_pos":     block["y0"],
                "x_pos":     block["center_x"]
            })
            continue

        shape_type = classify_shape_by_text(text)

        # Override with position heuristics
        if rel_y < 0.12:
            shape_type = "START"
        elif rel_y > 0.88 and shape_type == "UNKNOWN":
            shape_type = "NOTES"

        if shape_type == "START":
            flow["metadata"].append(text)

        elif shape_type == "DECISION":
            step_counter += 1
            flow["decisions"].append({
                "id":          f"pdf_{step_counter}",
                "text":        text,
                "shape_type":  "DECISION",
                "master_name": "inferred_from_text",
                "x":           block["center_x"],
                "y":           -block["y0"],
                "step_number": step_counter,
                "yes_path":    {"action": "unknown", "target_text": "", "target_id": ""},
                "no_path":     {"action": "unknown", "target_text": "", "target_id": ""},
                "page":        block["page"] + 1
            })

        elif shape_type == "END":
            flow["end_states"].append(text)

        elif shape_type == "PROCESS":
            flow["processes"].append({
                "id":         f"pdf_proc_{len(flow['processes'])}",
                "text":       text,
                "shape_type": "PROCESS",
                "x":          block["center_x"],
                "y":          -block["y0"],
                "page":       block["page"] + 1
            })

        elif shape_type == "NOTES":
            flow["notes"].append(text)

        else:
            flow["unknown_shapes"].append({
                "text": text,
                "y":    block["y0"],
                "page": block["page"] + 1
            })

    # Associate YES/NO connectors with nearest decision above
    for connector in flow["connectors"]:
        label   = connector["label"].upper()
        conn_y  = -connector["y_pos"]
        conn_x  = connector["x_pos"]

        decisions_above = [
            d for d in flow["decisions"]
            if d["y"] <= conn_y
        ]
        if decisions_above:
            closest = max(decisions_above, key=lambda d: d["y"])
            action  = "exclude" if conn_x > closest["x"] + 50 else "continue"

            if label == "YES":
                closest["yes_path"]["action"] = action
            elif label == "NO":
                closest["no_path"]["action"] = action

    return flow


