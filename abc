                "attribute": attribute,
                "layer": "Source",
                "asset": dataset_name,
                "asset_type": "Dataset",
                "classification": "SOURCE_CANDIDATE",
                "action": (
                    f"Validate that {dataset_name} is an approved source for "
                    f"{attribute}, including business meaning, datatype, nullability, "
                    "historical coverage, and permitted use."
                ),
                "priority": "Medium",
                "confidence": phase2_result.get("confidence", "Medium"),
                "approval": "Data Owner + Business SME",
                "evidence_basis": "Candidate dataset identified by Phase 2.",
                "status": "Validation Required"
            })

        for dataset_name in impacted_datasets:
            work_items.append({
                "work_item_id": f"{attribute}-SCHEMA-{len(work_items) + 1:03d}",
                "attribute": attribute,
                "layer": "Dataset Schema",
                "asset": dataset_name,
                "asset_type": "Dataset",
                "classification": "SCHEMA_IMPACT",
                "action": (
                    f"Confirm whether {attribute} must be exposed in {dataset_name}; "
                    "refresh the output schema only after recipe-level validation."
                ),
                "priority": "Medium",
                "confidence": phase2_result.get("confidence", "Medium"),
                "approval": "Data Engineer + Consumer",
                "evidence_basis": "Downstream dataset identified by Phase 2 lineage.",
                "status": "Review Required"
            })

    # Test scope
    if feasibility != "Not Confirmed":
        standard_tests = [
            ("Schema", f"Verify {attribute} exists in approved output schemas with the expected datatype."),
            ("Completeness", f"Validate null rate and population coverage for {attribute}."),
            ("Regression", f"Confirm existing row counts and key metrics are unchanged after propagating {attribute}."),
            ("Lineage", f"Validate {attribute} across each approved source-to-output path."),
            ("Consumer", f"Confirm downstream consumers can read {attribute} without breaking existing contracts.")
        ]

        for test_type, description in standard_tests:
            test_items.append({
                "test_id": f"{attribute}-TEST-{len(test_items) + 1:03d}",
                "attribute": attribute,
                "test_type": test_type,
                "description": description,
                "owner": "Engineering / QA",
                "required": True
            })

    # Approval checklist
    approvals = [
        ("Business Definition", "Business SME"),
        ("Source and Permitted Use", "Data Owner"),
        ("Transformation Design", "Data Engineer / Tech Lead"),
        ("Downstream Consumer Impact", "Product Owner / Consumer"),
        ("Test Evidence", "Engineering / QA")
    ]

    for approval_name, approver in approvals:
        approval_items.append({
            "attribute": attribute,
            "approval": approval_name,
            "approver": approver,
            "status": "Pending"
        })

    attribute_scopes.append({
        "attribute": attribute,
        "feasibility": feasibility,
        "confidence": phase2_result.get("confidence"),
        "complexity": phase2_result.get("complexity"),
        "metadata_risk": phase2_result.get("risk"),
        "scope_status": scope_status,
        "readiness": readiness,
        "candidate_datasets": sorted(set(candidate_datasets)),
        "impacted_recipes": sorted(set(impacted_recipes)),
        "impacted_datasets": sorted(set(impacted_datasets)),
        "classification_counts": dict(classifications),
        "blockers": blockers,
        "assumptions": assumptions
    })


###############################################################################
# STEP 6 - DEDUPLICATE WORK PACKAGE ITEMS
###############################################################################

