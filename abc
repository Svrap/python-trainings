# -*- coding: utf-8 -*-

import dataiku
import json
from datetime import datetime

# ==========================================================================
# CONFIG
# ==========================================================================

PROJECT_KEY = dataiku.default_project_key()

# ==========================================================================
# INIT
# ==========================================================================

client = dataiku.api_client()
project = client.get_project(PROJECT_KEY)

print("=" * 80)
print("ARIS PROJECT SCANNER")
print("=" * 80)
print("Project:", PROJECT_KEY)

# ==========================================================================
# FIND ARIS MANAGED FOLDER
# ==========================================================================

managed_folders = project.list_managed_folders()

folder_id = None
folder_name = None

for folder in managed_folders:

    if folder["name"].upper() == "ARIS_CONTEXT":

        folder_id = folder["id"]
        folder_name = folder["name"]
        break

if folder_id is None:

    raise Exception(
        "Managed Folder 'ARIS_CONTEXT' not found.\n"
        "Please create a Managed Folder named ARIS_CONTEXT."
    )

Context_files = dataiku.Folder(folder_id)

print("Managed Folder:", folder_name)
print("Folder ID:", folder_id)

# ==========================================================================
# HELPER
# ==========================================================================

def save_json(filename, data):

    with Context_files.get_writer(filename) as writer:

        writer.write(
            json.dumps(
                data,
                indent=2,
                default=str
            ).encode("utf-8")
        )

    print("Saved:", filename)

# ==========================================================================
# OUTPUT STRUCTURES
# ==========================================================================

project_scan = {
    "project": PROJECT_KEY,
    "scan_timestamp": str(datetime.now()),
    "recipes": [],
    "datasets": [],
    "edges": []
}

recipe_intelligence = []

dataset_registry = {}

# ==========================================================================
# RECIPES
# ==========================================================================

recipes = project.list_recipes()

print("\n" + "=" * 80)
print("SCANNING RECIPES")
print("=" * 80)

for recipe_info in recipes:

    recipe_name = recipe_info["name"]
    recipe_type = recipe_info.get("type")

    print("Scanning Recipe:", recipe_name)

    try:

        recipe_obj = project.get_recipe(recipe_name)
        settings = recipe_obj.get_settings()

    except Exception as e:

        print("Failed:", recipe_name, str(e))
        continue

    # ----------------------------------------------------------
    # INPUTS
    # ----------------------------------------------------------

    try:
        inputs = settings.get_recipe_inputs()
    except:
        inputs = {}

    # ----------------------------------------------------------
    # OUTPUTS
    # ----------------------------------------------------------

    try:
        outputs = settings.get_recipe_outputs()
    except:
        outputs = {}

    # ----------------------------------------------------------
    # FLOW GRAPH
    # ----------------------------------------------------------

    project_scan["recipes"].append({
        "name": recipe_name,
        "type": recipe_type
    })

    try:

        for role, vals in inputs.items():

            for item in vals:

                ds = item.get("ref")

                if ds:

                    project_scan["edges"].append({
                        "source": ds,
                        "target": recipe_name,
                        "relationship": "INPUT"
                    })

    except:
        pass

    try:

        for role, vals in outputs.items():

            for item in vals:

                ds = item.get("ref")

                if ds:

                    project_scan["edges"].append({
                        "source": recipe_name,
                        "target": ds,
                        "relationship": "OUTPUT"
                    })

    except:
        pass

    # ----------------------------------------------------------
    # RAW DEFINITION
    # ----------------------------------------------------------

    try:
        raw_definition = settings.get_recipe_raw_definition()
    except:
        raw_definition = {}

    # ----------------------------------------------------------
    # PARAMETERS
    # ----------------------------------------------------------

    try:
        params = settings.get_recipe_params()
    except:
        params = {}

    # ----------------------------------------------------------
    # PAYLOAD
    # ----------------------------------------------------------

    try:
        payload = settings.get_payload()
    except:
        payload = None

    # ----------------------------------------------------------
    # JSON PAYLOAD
    # ----------------------------------------------------------

    try:
        json_payload = settings.get_json_payload()
    except:
        json_payload = None

    # ----------------------------------------------------------
    # GENERATED SQL
    # ----------------------------------------------------------

    generated_sql = None

    try:

        status = recipe_obj.get_status()

        if hasattr(status, "data"):

            if isinstance(status.data, dict):

                generated_sql = status.data.get("sql")

    except:
        pass

    # ----------------------------------------------------------
    # JOINS
    # ----------------------------------------------------------

    joins = []

    if hasattr(settings, "raw_joins"):

        try:
            joins = settings.raw_joins
        except:
            pass

    # ----------------------------------------------------------
    # CODE
    # ----------------------------------------------------------

    recipe_code = None

    if hasattr(settings, "get_code"):

        try:
            recipe_code = settings.get_code()
        except:
            pass

    # ----------------------------------------------------------
    # STORE
    # ----------------------------------------------------------

    recipe_intelligence.append({

        "recipe_name": recipe_name,
        "recipe_type": recipe_type,
        "settings_class": type(settings).__name__,

        "inputs": inputs,
        "outputs": outputs,

        "joins": joins,

        "params": params,

        "generated_sql": generated_sql,

        "raw_definition": raw_definition,

        "payload": payload,

        "json_payload": json_payload,

        "code": recipe_code

    })

# ==========================================================================
# DATASETS
# ==========================================================================

print("\n" + "=" * 80)
print("SCANNING DATASETS")
print("=" * 80)

for dataset_info in project.list_datasets():

    dataset_name = dataset_info["name"]

    print("Dataset:", dataset_name)

    try:

        dataset = project.get_dataset(dataset_name)

        try:
            schema = dataset.get_schema()
        except:
            schema = {}

        try:
            settings = dataset.get_settings().get_raw()
        except:
            settings = {}

        dataset_registry[dataset_name] = {
            "schema": schema,
            "settings": settings
        }

        project_scan["datasets"].append({
            "name": dataset_name
        })

    except Exception as e:

        dataset_registry[dataset_name] = {
            "error": str(e)
        }

# ==========================================================================
# SAVE OUTPUTS
# ==========================================================================

save_json(
    "ARIS_PROJECT_GRAPH.json",
    project_scan
)

save_json(
    "ARIS_RECIPE_INTELLIGENCE.json",
    recipe_intelligence
)

save_json(
    "ARIS_DATASET_REGISTRY.json",
    dataset_registry
)

# ==========================================================================
# SUMMARY
# ==========================================================================

summary = {

    "project": PROJECT_KEY,
    "scan_timestamp": str(datetime.now()),

    "recipes": len(project_scan["recipes"]),
    "datasets": len(project_scan["datasets"]),
    "edges": len(project_scan["edges"])

}

save_json(
    "ARIS_SUMMARY.json",
    summary
)

# ==========================================================================
# LIST FILES
# ==========================================================================

print("\n" + "=" * 80)
print("FILES WRITTEN")
print("=" * 80)

try:

    for f in Context_files.list_paths_in_partition():

        print(" -", f)

except Exception as e:

    print(str(e))

# ==========================================================================
# COMPLETE
# ==========================================================================

print("\n" + "=" * 80)
print("SCAN COMPLETE")
print("=" * 80)

print(json.dumps(summary, indent=2))
