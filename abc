def normalize_name(value):
    """Normalize names for case- and separator-insensitive comparison."""
    if value is None:
        return ""
    return re.sub(r"[^a-z0-9]", "", str(value).lower())


def unique_preserve_order(values):
    """Remove duplicates while preserving order."""
    seen = set()
    output = []
    for value in values:
        key = json.dumps(value, sort_keys=True, default=str) if isinstance(value, (dict, list)) else str(value)
        if key not in seen:
            seen.add(key)
            output.append(value)
    return output


def to_serializable(value):
    """Convert Dataiku/API payload objects into JSON-compatible structures."""
    if value is None or isinstance(value, (str, int, float, bool)):
        return value
    if isinstance(value, dict):
        return {str(k): to_serializable(v) for k, v in value.items()}
    if isinstance(value, (list, tuple, set)):
        return [to_serializable(v) for v in value]
    if hasattr(value, "to_dict"):
        try:
            return to_serializable(value.to_dict())
        except Exception:
            pass
    if hasattr(value, "__dict__"):
        try:
            return to_serializable(value.__dict__)
        except Exception:
            pass
    return repr(value)


def flatten_strings(value, path="root"):
    """Recursively collect strings from a nested definition/payload."""
    flattened = []

    if isinstance(value, str):
        flattened.append({"path": path, "text": value})

    elif isinstance(value, dict):
        for key, child in value.items():
            flattened.extend(flatten_strings(child, f"{path}.{key}"))

    elif isinstance(value, (list, tuple)):
        for index, child in enumerate(value):
            flattened.extend(flatten_strings(child, f"{path}[{index}]"))

    return flattened


def attribute_regex(attribute):
    """Build a conservative, case-insensitive attribute reference pattern."""
    parts = [part for part in re.split(r"[^A-Za-z0-9]+", str(attribute)) if part]
    if not parts:
        return re.compile(r"a^")

    # Allow underscore, hyphen, whitespace, or dot between attribute tokens.
    separator = r"[\s_.-]*"
    pattern = r"(?<![A-Za-z0-9])" + separator.join(re.escape(part) for part in parts) + r"(?![A-Za-z0-9])"
    return re.compile(pattern, re.IGNORECASE)


def extract_attribute_evidence(attribute, flattened_strings):
    """Return paths and snippets containing the requested attribute."""
    pattern = attribute_regex(attribute)
    evidence = []

    for item in flattened_strings:
        text = item["text"]
        match = pattern.search(text)
        if not match:
            continue

        start = max(0, match.start() - 180)
        end = min(len(text), match.end() + 260)
        snippet = text[start:end].replace("\n", " ").strip()

        if len(snippet) > MAX_EVIDENCE_SNIPPET_LENGTH:
            snippet = snippet[:MAX_EVIDENCE_SNIPPET_LENGTH] + "..."

        evidence.append({
            "path": item["path"],
            "snippet": snippet
        })

    return unique_preserve_order(evidence)


def markdown_table(records, columns):
    """Create a Markdown table."""
    if not records:
        return "_No records found._"

    lines = [
        "| " + " | ".join(columns) + " |",
        "| " + " | ".join(["---"] * len(columns)) + " |"
    ]

    for record in records:
        cells = []
        for column in columns:
            value = record.get(column, "")
            if value is None:
                value = ""
            value = str(value).replace("|", "\\|").replace("\n", " ")
            cells.append(value)
        lines.append("| " + " | ".join(cells) + " |")

    return "\n".join(lines)


def console_table(records, columns):
    """Print a compact matrix in the notebook output."""
    if not records:
        print("No records found.")
        return

    widths = {
        column: max(
            len(column),
            max(len(str(record.get(column, ""))) for record in records)
        )
        for column in columns
    }

    header = " | ".join(column.ljust(widths[column]) for column in columns)
    separator = "-+-".join("-" * widths[column] for column in columns)

    print(header)
    print(separator)
    for record in records:
        print(
            " | ".join(
                str(record.get(column, "")).ljust(widths[column])
                for column in columns
            )
        )


