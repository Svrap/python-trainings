def extract_recipe_payload(recipe_name):
    """
    Read a recipe definition/payload without modifying the recipe.

    get_definition_and_payload() varies by recipe type and Dataiku version.
    This function stores a serializable structure and extraction metadata.
    """
    result = {
        "recipe": recipe_name,
        "extraction_status": "unknown",
        "definition": None,
        "payload": None,
        "error": None
    }

    try:
        recipe = project.get_recipe(recipe_name)
        raw = recipe.get_definition_and_payload()
        serializable = to_serializable(raw)

        if isinstance(serializable, list) and len(serializable) >= 2:
            result["definition"] = serializable[0]
            result["payload"] = serializable[1]
        else:
            result["definition"] = serializable

        result["extraction_status"] = "success"

    except Exception as error:
        result["extraction_status"] = "error"
        result["error"] = str(error)

    return result


