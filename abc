###############################################################################
# STEP 6 - COLUMN SEARCH
###############################################################################

def find_column_matches(search_term):
    """Return exact and partial dataset-column matches for one attribute."""
    normalized_term = normalize_name(search_term)
    exact_matches = []
    partial_matches = []

    for normalized_column, locations in column_index.items():
        if normalized_column == normalized_term:
            for location in locations:
                exact_matches.append({
                    **location,
                    "search_term": search_term,
                    "match_type": "Exact"
                })

        elif (
            normalized_term
            and normalized_column
            and (
                normalized_term in normalized_column
                or normalized_column in normalized_term
            )
        ):
            for location in locations:
                partial_matches.append({
                    **location,
                    "search_term": search_term,
                    "match_type": "Partial"
                })

    exact_matches = deduplicate_dicts(
        exact_matches,
        ["search_term", "dataset", "column"]
    )
    partial_matches = deduplicate_dicts(
        partial_matches,
        ["search_term", "dataset", "column"]
    )

    return exact_matches, partial_matches


###############################################################################
# STEP 7 - DATASET POSITION AND DOWNSTREAM LINEAGE
###############################################################################

def classify_dataset(dataset_name):
    """Classify the dataset's structural position in captured lineage."""
    has_upstream = bool(upstream_edges.get(dataset_name))
    has_downstream = bool(downstream_edges.get(dataset_name))

    if not has_upstream and has_downstream:
        return "Source / Entry"
    if has_upstream and has_downstream:
        return "Intermediate"
    if has_upstream and not has_downstream:
        return "Terminal Output"
    return "Isolated / External"


def trace_downstream(start_dataset, max_depth=10, max_paths=50):
    """Traverse captured downstream dataset-level lineage."""
    queue = deque([{
        "dataset": start_dataset,
        "depth": 0,
        "path": [start_dataset],
        "visited": {start_dataset}
    }])

    impacted_datasets = set()
    impacted_recipes = set()
    completed_paths = []
    cycles = []
    truncated = False
    maximum_depth_reached = 0

    while queue:
        current = queue.popleft()
        current_dataset = current["dataset"]
        current_depth = current["depth"]
        current_path = current["path"]
        visited = current["visited"]

        maximum_depth_reached = max(maximum_depth_reached, current_depth)
        outgoing = downstream_edges.get(current_dataset, [])

        if not outgoing or current_depth >= max_depth:
            completed_paths.append(current_path)
            if len(completed_paths) >= max_paths:
                truncated = True
                break
            continue

        for edge in outgoing:
            next_dataset = edge["target"]
            recipe_name = edge["recipe"]

            impacted_datasets.add(next_dataset)
            impacted_recipes.add(recipe_name)

            next_path = (
                current_path
                + [f"[Recipe: {recipe_name}]"]
                + [next_dataset]
            )

            if next_dataset in visited:
                cycles.append(next_path)
                completed_paths.append(next_path + ["[Cycle stopped]"])
                continue

            queue.append({
                "dataset": next_dataset,
                "depth": current_depth + 1,
                "path": next_path,
                "visited": visited | {next_dataset}
            })

    return {
        "impacted_datasets": sorted(impacted_datasets),
        "impacted_recipes": sorted(impacted_recipes),
        "paths": completed_paths,
        "cycles": cycles,
        "path_count": len(completed_paths),
        "maximum_depth_reached": maximum_depth_reached,
        "truncated": truncated
    }


###############################################################################
# STEP 8 - ANALYZE EACH ATTRIBUTE INDEPENDENTLY
###############################################################################

def analyze_attribute(search_term):
    """Analyze one requested attribute independently."""
    exact_matches, partial_matches = find_column_matches(search_term)

    # Exact results take precedence. Partial results are used only when no
    # exact match exists, preventing duplicate candidate inflation.
    selected_matches = exact_matches if exact_matches else partial_matches

    candidate_analyses = []
    impacted_recipes = set()
    impacted_datasets = set()

    for match in selected_matches:
        downstream = trace_downstream(
            match["dataset"],
            MAX_DOWNSTREAM_DEPTH,
            MAX_PATHS_PER_MATCH
        )

        candidate_analyses.append({
            "match_type": match["match_type"],
            "matched_column": match["column"],
            "column_type": match.get("column_type"),
            "dataset": match["dataset"],
            "dataset_position": classify_dataset(match["dataset"]),
            "connection": match.get("connection"),
            "schema": match.get("schema"),
            "table": match.get("table"),
            "immediate_upstream": upstream_edges.get(match["dataset"], []),
            "immediate_downstream": downstream_edges.get(match["dataset"], []),
            "downstream": downstream
        })

        impacted_recipes.update(downstream["impacted_recipes"])
        impacted_datasets.update(downstream["impacted_datasets"])

    # Feasibility and confidence
    if exact_matches:
        feasibility = "Potentially Feasible"
        feasibility_basis = (
            "At least one exact column-name match was found in the Phase 1 "
            "dataset schemas."
        )
        confidence = "High" if impacted_recipes else "Medium"
        confidence_basis = (
            "Exact schema matches and downstream dataset-level lineage were found."
            if impacted_recipes
            else "Exact schema matches were found, but no downstream lineage was captured."
        )
    elif partial_matches:
        feasibility = "Requires Validation"
        feasibility_basis = (
            "Only partial column-name matches were found. Business meaning and "
            "naming must be validated."
        )
        confidence = "Medium"
        confidence_basis = "Only partial schema matches were found."
    else:
        feasibility = "Not Confirmed"
        feasibility_basis = (
            "No matching column was found in the captured dataset schemas."
        )
        confidence = "Low"
        confidence_basis = "No schema evidence was found for the requested attribute."

    # Recipe type distribution
    recipe_type_distribution = defaultdict(int)
    for recipe_name in impacted_recipes:
        recipe_type = recipe_by_name.get(recipe_name, {}).get("type", "unknown")
        recipe_type_distribution[recipe_type] += 1

    # Transparent complexity score. This is triage, not an effort estimate.
    recipe_count = len(impacted_recipes)
    dataset_count = len(impacted_datasets)
    custom_code_count = (
        recipe_type_distribution.get("python", 0)
        + recipe_type_distribution.get("pyspark", 0)
        + recipe_type_distribution.get("sql_script", 0)
    )
    join_count = recipe_type_distribution.get("join", 0)

    complexity_score = 0
    complexity_reasons = []

    if recipe_count >= 10:
        complexity_score += 4
        complexity_reasons.append("10 or more impacted recipes")
    elif recipe_count >= 5:
        complexity_score += 3
        complexity_reasons.append("5 to 9 impacted recipes")
    elif recipe_count >= 1:
        complexity_score += 1
        complexity_reasons.append("1 to 4 impacted recipes")

    if dataset_count >= 10:
        complexity_score += 3
        complexity_reasons.append("10 or more impacted datasets")
    elif dataset_count >= 5:
        complexity_score += 2
        complexity_reasons.append("5 to 9 impacted datasets")
    elif dataset_count >= 1:
        complexity_score += 1
        complexity_reasons.append("1 to 4 impacted datasets")

    if custom_code_count >= 3:
        complexity_score += 3
        complexity_reasons.append("Multiple custom-code recipes")
    elif custom_code_count >= 1:
        complexity_score += 1
        complexity_reasons.append("At least one custom-code recipe")

    if join_count >= 3:
        complexity_score += 2
        complexity_reasons.append("Multiple join recipes")
    elif join_count >= 1:
        complexity_score += 1
        complexity_reasons.append("At least one join recipe")

    complexity = complexity_label(complexity_score)

    # Transparent risk score. This is triage, not delivery risk certification.
    risk_score = 0
    risk_reasons = []

    if not exact_matches:
        risk_score += 3
        risk_reasons.append("No exact schema match")

    if selected_matches and not impacted_recipes:
        risk_score += 2
        risk_reasons.append("No downstream lineage captured")

    if custom_code_count:
        risk_score += 2
        risk_reasons.append("Code-level column propagation is unverified")

    if dataset_extraction_errors:
        risk_score += 1
        risk_reasons.append("Dataset metadata extraction errors exist")

    if recipe_extraction_errors:
        risk_score += 1
        risk_reasons.append("Recipe metadata extraction errors exist")

    if any(item["downstream"]["cycles"] for item in candidate_analyses):
        risk_score += 1
        risk_reasons.append("Cycle detected in captured lineage")

    if any(item["downstream"]["truncated"] for item in candidate_analyses):
        risk_score += 1
        risk_reasons.append("Configured lineage path limit was reached")

    risk = risk_label(risk_score)

    # Proposed scope actions
    if feasibility == "Not Confirmed":
        scope_actions = [
            {
                "layer": "Business Requirement",
                "action": (
                    "Clarify definition, synonyms, datatype, grain, and sample values."
                ),
                "approval": "Business SME"
            },
            {
                "layer": "Upstream Discovery",
                "action": (
                    "Search upstream systems or adjacent Dataiku projects."
                ),
                "approval": "Data SME"
            }
        ]
    else:
        scope_actions = [
            {
                "layer": "Source",
                "action": (
                    "Validate the candidate source dataset and business meaning."
                ),
                "approval": "Data Owner / SME"
            },
