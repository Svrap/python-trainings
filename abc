def normalize_name(value):
    """Normalize names for case- and separator-insensitive comparison."""
    if value is None:
        return ""
    return re.sub(r"[^a-z0-9]", "", str(value).lower())


def unique_terms(values):
    """Remove blank and duplicate search terms while preserving order."""
    seen = set()
    output = []

    for value in values:
        clean_value = str(value).strip()
        key = normalize_name(clean_value)

        if clean_value and key and key not in seen:
            seen.add(key)
            output.append(clean_value)

    return output


def deduplicate_dicts(records, fields):
    """Deduplicate dictionaries using selected fields."""
    seen = set()
    output = []

    for record in records:
        key = tuple(record.get(field) for field in fields)
        if key not in seen:
            seen.add(key)
            output.append(record)

    return output


def complexity_label(score):
    """Convert the transparent PoC complexity score into a label."""
    if score >= 8:
        return "High"
    if score >= 4:
        return "Medium"
    return "Low"


def risk_label(score):
    """Convert the transparent PoC risk score into a label."""
    if score >= 7:
        return "High"
    if score >= 4:
        return "Medium"
    return "Low"


def markdown_table(records, columns):
    """Convert dictionaries into a Markdown table."""
    if not records:
        return "_No records found._"

    lines = [
        "| " + " | ".join(columns) + " |",
        "| " + " | ".join(["---"] * len(columns)) + " |"
    ]

    for record in records:
        cells = []
        for column in columns:
            value = record.get(column, "")
            if value is None:
                value = ""
            value = str(value).replace("|", "\\|").replace("\n", " ")
            cells.append(value)
        lines.append("| " + " | ".join(cells) + " |")

    return "\n".join(lines)


def console_table(records, columns):
    """Print a compact console table."""
    if not records:
        print("No records found.")
        return

    widths = {
        column: max(
            len(column),
            max(len(str(record.get(column, ""))) for record in records)
        )
        for column in columns
    }

    header = " | ".join(column.ljust(widths[column]) for column in columns)
    separator = "-+-".join("-" * widths[column] for column in columns)

    print(header)
    print(separator)

    for record in records:
        print(
            " | ".join(
                str(record.get(column, "")).ljust(widths[column])
                for column in columns
            )
        )


