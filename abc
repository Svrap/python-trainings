                "JOIN_KEY",
                "Medium",
                "Attribute is present in input/output schemas and referenced in Join configuration."
            )
        return (
            "PASSTHROUGH",
            "Medium",
            "Attribute is present in both known input and output schemas."
        )

    if not input_present and output_present:
        if code_referenced:
            return (
                "CREATED",
                "High",
                "Attribute is absent from known inputs, present in outputs, and referenced in recipe content."
            )
        return (
            "CREATED",
            "Medium",
            "Attribute is absent from known input schemas but present in output schemas."
        )

    if input_present and not output_present:
        if code_referenced and normalized_type == "join":
            return (
                "JOIN_KEY",
                "Low",
                "Attribute is referenced in Join configuration but is absent from known output schemas."
            )
        if code_referenced and normalized_type in {"prepare", "filter", "window"}:
            return (
                "FILTER_OR_RULE",
                "Low",
                "Attribute is referenced in visual recipe content but is absent from known output schemas."
            )
        if code_referenced:
            return (
                "REFERENCED",
                "Low",
                "Attribute is referenced in recipe content but is absent from known output schemas."
            )
        return (
            "DROPPED",
            "Medium",
            "Attribute is present in known input schemas and absent from known output schemas."
        )

    if code_referenced:
        if normalized_type == "join":
            return (
                "JOIN_KEY",
                "Low",
                "Attribute is referenced in Join configuration, but schema evidence is incomplete."
            )
        if normalized_type in {"prepare", "filter", "window"}:
