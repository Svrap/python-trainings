        #######################################################################

        for role in recipe_inputs.values():

            for item in role.get("items", []):

                inputs.append(item["ref"])

        #######################################################################
        # OUTPUT DATASETS
        #######################################################################

        for role in recipe_outputs.values():

            for item in role.get("items", []):

                outputs.append(item["ref"])

        recipe_info = {
            "name": r["name"],
            "type": r["type"],
            "inputs": inputs,
            "outputs": outputs
        }

        aris_context["recipes"].append(recipe_info)

        #######################################################################
        # BUILD LINEAGE GRAPH EDGES
        #######################################################################

