# -*- coding: utf-8 -*-
"""
ARIS Dataiku Project Analyzer

Purpose
-------
Dynamically analyzes the active Dataiku project and saves project context to
managed folder UIx90ux3.

Captured
--------
- Project metadata
- All datasets and schemas
- All recipes and recipe types
- Recipe inputs and outputs
- SQL/query content available in params, payloads, or definitions
- Python/code recipe content through get_code()
- Join recipe configuration through raw_joins
- Visual recipe payloads, parameters, and definitions
- Dataset -> recipe -> dataset lineage
- Source, intermediate, terminal, and isolated datasets
- Extraction errors without stopping the complete scan

Safety
------
- Read-only analysis of the Dataiku project
- Does not build recipes or modify project objects
- Dynamically uses the active project key
- Saves outputs only to managed folder UIx90ux3
"""

import json
import hashlib
import traceback
from collections import Counter, defaultdict
from datetime import datetime, timezone

import dataiku


# =============================================================================
# CONFIGURATION
# =============================================================================

FOLDER_ID = "UIx90ux3"
INCLUDE_DATASET_SCHEMAS = True
INCLUDE_DATASET_SETTINGS = True
INCLUDE_FULL_RECIPE_DEFINITIONS = True
INCLUDE_FULL_PAYLOADS = True
INCLUDE_ERROR_TRACEBACKS = False
JSON_INDENT = 2


# =============================================================================
# GENERIC HELPERS
# =============================================================================

def utc_now():
    return datetime.now(timezone.utc)


def json_safe(value):
    """Recursively convert Dataiku API values to JSON-safe values."""
    if value is None or isinstance(value, (str, int, float, bool)):
        return value

    if isinstance(value, dict):
        return {str(key): json_safe(item) for key, item in value.items()}

    if isinstance(value, (list, tuple, set)):
        return [json_safe(item) for item in value]

    try:
        return json_safe(dict(value))
    except Exception:
        return str(value)


def safe_method(obj, method_name, default=None):
    """Call a zero-argument method and return value plus an error string."""
    method = getattr(obj, method_name, None)
    if not callable(method):
        return default, "Method not available"

    try:
        return method(), None
    except Exception as exc:
        return default, str(exc)


def safe_attribute(obj, attribute_name, default=None):
    """Read an attribute and return value plus an error string."""
    try:
        return getattr(obj, attribute_name), None
    except Exception as exc:
        return default, str(exc)


def unique_strings(values):
    result = []
    seen = set()

    for value in values or []:
        if value is None:
            continue
        text = str(value).strip()
        if text and text not in seen:
            seen.add(text)
            result.append(text)

    return result


def normalize_refs(value):
    """Normalize Dataiku flat input/output references into strings."""
    refs = []

    def walk(node):
        if node is None:
            return

        if isinstance(node, str):
            refs.append(node)
            return

        if isinstance(node, dict):
            preferred_keys = (
                "ref", "name", "dataset", "datasetName", "datasetRef",
                "id", "fullName"
            )
            matched = False

            for key in preferred_keys:
                candidate = node.get(key)
                if isinstance(candidate, str) and candidate.strip():
                    refs.append(candidate)
                    matched = True

            if not matched:
                for child in node.values():
                    walk(child)
            return

        if isinstance(node, (list, tuple, set)):
            for child in node:
                walk(child)
            return

        refs.append(str(node))

    walk(value)
    return unique_strings(refs)


def recursive_find_fields(value, target_keys, path="root"):
    """Find fields such as sql, query, script, formula, and processors."""
    matches = []

    if isinstance(value, dict):
        for key, child in value.items():
            child_path = "{}.{}".format(path, key)
            normalized_key = str(key).replace("_", "").replace("-", "").lower()

            if normalized_key in target_keys:
                matches.append({
                    "path": child_path,
                    "field": str(key),
                    "value": json_safe(child)
                })

            matches.extend(recursive_find_fields(child, target_keys, child_path))

    elif isinstance(value, list):
        for index, child in enumerate(value):
            matches.extend(
                recursive_find_fields(child, target_keys, "{}[{}]".format(path, index))
            )

    return matches


def content_hash(value):
    text = json.dumps(json_safe(value), sort_keys=True, default=str, ensure_ascii=False)
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def append_error(errors, scope, object_name, operation, error):
    if not error or error == "Method not available":
        return

    errors.append({
        "scope": scope,
        "object": object_name,
        "operation": operation,
        "error": error
    })


# =============================================================================
# DATASET EXTRACTION
# =============================================================================

def extract_dataset(project, dataset_summary, errors):
    dataset_name = dataset_summary.get("name")
    record = {
        "name": dataset_name,
        "summary": json_safe(dataset_summary)
    }

    try:
        dataset = project.get_dataset(dataset_name)

        if INCLUDE_DATASET_SCHEMAS:
            schema, error = safe_method(dataset, "get_schema", default=None)
            if schema is not None:
                record["schema"] = json_safe(schema)
            append_error(errors, "dataset", dataset_name, "get_schema", error)

        if INCLUDE_DATASET_SETTINGS:
            settings, error = safe_method(dataset, "get_settings", default=None)
            append_error(errors, "dataset", dataset_name, "get_settings", error)

            if settings is not None:
                record["settings_class"] = type(settings).__name__

                settings_value = None
                retrieved_with = None

                for method_name in ("get_raw", "get_raw_params"):
                    value, method_error = safe_method(settings, method_name, default=None)
                    if value is not None:
                        settings_value = value
                        retrieved_with = method_name
                        break
                    append_error(
                        errors, "dataset", dataset_name,
                        "settings.{}".format(method_name), method_error
                    )

                if settings_value is not None:
                    record["settings_retrieved_with"] = retrieved_with
                    record["settings"] = json_safe(settings_value)

        record["content_hash"] = content_hash(record)

    except Exception as exc:
        record["error"] = str(exc)
        append_error(errors, "dataset", dataset_name, "extract_dataset", str(exc))
        if INCLUDE_ERROR_TRACEBACKS:
            record["traceback"] = traceback.format_exc()

    return record


# =============================================================================
# RECIPE EXTRACTION
# =============================================================================

def extract_recipe(project, recipe_summary, errors):
    recipe_name = recipe_summary.get("name")
    recipe_type = recipe_summary.get("type")

    record = {
        "name": recipe_name,
        "recipe_type": recipe_type,
        "summary": json_safe(recipe_summary),
        "inputs": [],
        "outputs": [],
        "logic": {
            "code": None,
            "sql_sections": [],
            "join_sections": [],
            "visual_logic_sections": []
        }
    }

    try:
        recipe = project.get_recipe(recipe_name)
        settings = recipe.get_settings()
        settings_class = type(settings).__name__

        record["settings_class"] = settings_class

        # Inputs and outputs: flat refs are preferred for lineage.
        flat_inputs, error = safe_method(settings, "get_flat_input_refs", default=[])
        append_error(errors, "recipe", recipe_name, "get_flat_input_refs", error)
        record["inputs"] = normalize_refs(flat_inputs)

        flat_outputs, error = safe_method(settings, "get_flat_output_refs", default=[])
        append_error(errors, "recipe", recipe_name, "get_flat_output_refs", error)
        record["outputs"] = normalize_refs(flat_outputs)

        # Preserve structured IO too.
        structured_inputs, error = safe_method(settings, "get_recipe_inputs", default=None)
        append_error(errors, "recipe", recipe_name, "get_recipe_inputs", error)
        if structured_inputs is not None:
            record["structured_inputs"] = json_safe(structured_inputs)

        structured_outputs, error = safe_method(settings, "get_recipe_outputs", default=None)
        append_error(errors, "recipe", recipe_name, "get_recipe_outputs", error)
        if structured_outputs is not None:
            record["structured_outputs"] = json_safe(structured_outputs)

        # Parameters.
        params, error = safe_method(settings, "get_recipe_params", default=None)
        append_error(errors, "recipe", recipe_name, "get_recipe_params", error)
        if params is not None:
            record["params"] = json_safe(params)

        raw_params, error = safe_attribute(settings, "raw_params", default=None)
        append_error(errors, "recipe", recipe_name, "raw_params", error)
        if raw_params is not None:
            record["raw_params"] = json_safe(raw_params)

        # Complete recipe definition.
        definition, error = safe_method(
            settings, "get_recipe_raw_definition", default=None
        )
        append_error(
            errors, "recipe", recipe_name, "get_recipe_raw_definition", error
        )
        definition = json_safe(definition) if definition is not None else None
        if INCLUDE_FULL_RECIPE_DEFINITIONS and definition is not None:
            record["raw_definition"] = definition

        # Payloads. Keep representations because recipe types differ.
        payload, error = safe_method(settings, "get_payload", default=None)
        append_error(errors, "recipe", recipe_name, "get_payload", error)
        payload = json_safe(payload) if payload is not None else None
        if INCLUDE_FULL_PAYLOADS and payload is not None:
            record["payload"] = payload

        json_payload, error = safe_method(settings, "get_json_payload", default=None)
        append_error(errors, "recipe", recipe_name, "get_json_payload", error)
        json_payload = json_safe(json_payload) if json_payload is not None else None
        if INCLUDE_FULL_PAYLOADS and json_payload is not None:
            record["json_payload"] = json_payload

        str_payload, error = safe_attribute(settings, "str_payload", default=None)
        append_error(errors, "recipe", recipe_name, "str_payload", error)
        if INCLUDE_FULL_PAYLOADS and str_payload:
            record["str_payload"] = str(str_payload)

        obj_payload, error = safe_attribute(settings, "obj_payload", default=None)
        append_error(errors, "recipe", recipe_name, "obj_payload", error)
        obj_payload = json_safe(obj_payload) if obj_payload is not None else None
        if INCLUDE_FULL_PAYLOADS and obj_payload is not None:
            record["obj_payload"] = obj_payload

        # Python or other code recipes.
        if callable(getattr(settings, "get_code", None)):
            code, error = safe_method(settings, "get_code", default=None)
            append_error(errors, "recipe", recipe_name, "get_code", error)
            if code:
                record["logic"]["code"] = str(code)
                record["logic"]["code_length"] = len(str(code))

        # Join recipes: community-confirmed raw_joins attribute.
        if hasattr(settings, "raw_joins"):
            raw_joins, error = safe_attribute(settings, "raw_joins", default=None)
            append_error(errors, "recipe", recipe_name, "raw_joins", error)
            if raw_joins is not None:
                record["raw_joins"] = json_safe(raw_joins)

        # Search all available structures generically. This is not a business
        # keyword search. It identifies technical logic-bearing API fields.
        technical_sources = {
            "definition": definition,
            "params": json_safe(params) if params is not None else None,
            "raw_params": json_safe(raw_params) if raw_params is not None else None,
            "payload": payload,
            "json_payload": json_payload,
            "obj_payload": obj_payload
        }

        sql_keys = {"sql", "query", "sqlquery", "script"}
        join_keys = {
            "join", "joins", "rawjoins", "joinconditions", "conditions",
            "prejoincomputedcolumns", "postjoincomputedcolumns"
        }
        visual_keys = {
            "steps", "processor", "processors", "formula", "expression",
            "filter", "filters", "computedcolumn", "computedcolumns",
            "aggregation", "aggregations", "grouping", "window"
        }

        for source_name, source_value in technical_sources.items():
            if source_value is None:
                continue

            record["logic"]["sql_sections"].extend(
                recursive_find_fields(source_value, sql_keys, source_name)
            )
            record["logic"]["join_sections"].extend(
                recursive_find_fields(source_value, join_keys, source_name)
            )
            record["logic"]["visual_logic_sections"].extend(
                recursive_find_fields(source_value, visual_keys, source_name)
            )

        # Include raw_joins as a canonical join section.
        if record.get("raw_joins") is not None:
            record["logic"]["join_sections"].insert(0, {
                "path": "settings.raw_joins",
                "field": "raw_joins",
                "value": record["raw_joins"]
            })

        record["capabilities_found"] = {
            "has_code": bool(record["logic"].get("code")),
            "has_sql": bool(record["logic"].get("sql_sections")),
            "has_join_logic": bool(record["logic"].get("join_sections")),
            "has_visual_logic": bool(
                record["logic"].get("visual_logic_sections")
            ),
            "has_payload": payload is not None or json_payload is not None,
            "has_definition": definition is not None
        }

        record["content_hash"] = content_hash(record)

    except Exception as exc:
        record["error"] = str(exc)
        append_error(errors, "recipe", recipe_name, "extract_recipe", str(exc))
        if INCLUDE_ERROR_TRACEBACKS:
            record["traceback"] = traceback.format_exc()

    return record


# =============================================================================
# LINEAGE
# =============================================================================

def build_lineage(dataset_names, recipe_records):
    produced_by = defaultdict(list)
    consumed_by = defaultdict(list)
    edges = []

    for recipe in recipe_records:
        recipe_name = recipe.get("name")

        for dataset_name in recipe.get("inputs", []):
            consumed_by[dataset_name].append(recipe_name)
            edges.append({
                "from_type": "dataset",
                "from": dataset_name,
                "to_type": "recipe",
                "to": recipe_name
            })

        for dataset_name in recipe.get("outputs", []):
            produced_by[dataset_name].append(recipe_name)
            edges.append({
                "from_type": "recipe",
                "from": recipe_name,
                "to_type": "dataset",
                "to": dataset_name
            })

    all_datasets = set(dataset_names) | set(produced_by) | set(consumed_by)
    produced = set(produced_by)
    consumed = set(consumed_by)

    dataset_lineage = []
    for dataset_name in sorted(all_datasets):
        dataset_lineage.append({
            "dataset": dataset_name,
            "produced_by": sorted(unique_strings(produced_by.get(dataset_name, []))),
            "consumed_by": sorted(unique_strings(consumed_by.get(dataset_name, [])))
        })

    return {
        "edges": edges,
        "datasets": dataset_lineage,
        "source_datasets": sorted((all_datasets - produced) & consumed),
        "intermediate_datasets": sorted(produced & consumed),
        "terminal_datasets": sorted(produced - consumed),
        "isolated_datasets": sorted(all_datasets - produced - consumed)
    }


# =============================================================================
# MANAGED FOLDER OUTPUT
# =============================================================================

def upload_text(folder, path, text):
    folder.upload_data(path, text.encode("utf-8"))


def create_summary_markdown(context, files):
    summary = context["summary"]
    recipe_types = summary["recipe_types"]

    lines = [
        "# ARIS Project Analysis Summary",
        "",
        "## Project",
        "",
        "- Project key: `{}`".format(context["project_key"]),
        "- Generated at: `{}`".format(context["generated_at_utc"]),
        "- Managed folder ID: `{}`".format(context["managed_folder_id"]),
        "",
        "## Inventory",
        "",
        "- Total datasets: {}".format(summary["total_datasets"]),
        "- Total recipes: {}".format(summary["total_recipes"]),
        "- Total lineage edges: {}".format(summary["total_lineage_edges"]),
        "- Source datasets: {}".format(summary["source_datasets"]),
        "- Intermediate datasets: {}".format(summary["intermediate_datasets"]),
        "- Terminal datasets: {}".format(summary["terminal_datasets"]),
        "- Isolated datasets: {}".format(summary["isolated_datasets"]),
        "- Extraction errors: {}".format(summary["extraction_errors"]),
        "",
        "## Logic Coverage",
        "",
        "- Recipes with SQL: {}".format(summary["recipes_with_sql"]),
        "- Recipes with code: {}".format(summary["recipes_with_code"]),
        "- Recipes with join logic: {}".format(summary["recipes_with_join_logic"]),
        "- Recipes with visual logic: {}".format(summary["recipes_with_visual_logic"]),
        "",
        "## Recipe Types",
        "",
        "```json",
        json.dumps(recipe_types, indent=2, ensure_ascii=False),
        "```",
        "",
        "## Generated Files",
        ""
    ]

    for label, path in files.items():
        lines.append("- {}: `{}`".format(label, path))

    return "\n".join(lines) + "\n"


# =============================================================================
# MAIN
# =============================================================================

def main():
    generated_at = utc_now()
    generated_at_iso = generated_at.isoformat()
    timestamp = generated_at.strftime("%Y%m%d_%H%M%S_UTC")

    client = dataiku.api_client()

    # Always derive the active project dynamically. Never hardcode a key.
    project = client.get_default_project()
    project_key = project.project_key

    context_folder = dataiku.Folder(FOLDER_ID)

    errors = []

    print("=" * 100)
    print("ARIS DATAIKU PROJECT ANALYZER")
    print("=" * 100)
    print("Project key      :", project_key)
    print("Managed folder ID:", FOLDER_ID)
    print("Generated at UTC :", generated_at_iso)

    project_metadata, error = safe_method(project, "get_metadata", default={})
    append_error(errors, "project", project_key, "get_metadata", error)

    # Datasets
    print("\nScanning datasets...")
    dataset_summaries = project.list_datasets()
    dataset_records = []

    for index, dataset_summary in enumerate(dataset_summaries, start=1):
        dataset_name = dataset_summary.get("name", "UNKNOWN")
        print("  [{}/{}] {}".format(index, len(dataset_summaries), dataset_name))
        dataset_records.append(
            extract_dataset(project, dataset_summary, errors)
        )

    # Recipes
    print("\nScanning recipes...")
    recipe_summaries = project.list_recipes()
    recipe_records = []

    for index, recipe_summary in enumerate(recipe_summaries, start=1):
        recipe_name = recipe_summary.get("name", "UNKNOWN")
        print("  [{}/{}] {}".format(index, len(recipe_summaries), recipe_name))
        recipe_records.append(
            extract_recipe(project, recipe_summary, errors)
        )

    dataset_names = [
        item.get("name") for item in dataset_records if item.get("name")
    ]
    lineage = build_lineage(dataset_names, recipe_records)

    recipe_type_counter = Counter(
        recipe.get("recipe_type") or "UNKNOWN" for recipe in recipe_records
    )

    recipes_with_sql = sum(
        1 for recipe in recipe_records
        if recipe.get("capabilities_found", {}).get("has_sql")
    )
    recipes_with_code = sum(
        1 for recipe in recipe_records
        if recipe.get("capabilities_found", {}).get("has_code")
    )
    recipes_with_join_logic = sum(
        1 for recipe in recipe_records
        if recipe.get("capabilities_found", {}).get("has_join_logic")
    )
    recipes_with_visual_logic = sum(
        1 for recipe in recipe_records
        if recipe.get("capabilities_found", {}).get("has_visual_logic")
    )

    project_context = {
        "schema_version": "ARIS_PROJECT_CONTEXT_V1",
        "project_key": project_key,
        "managed_folder_id": FOLDER_ID,
        "generated_at_utc": generated_at_iso,
        "project_metadata": json_safe(project_metadata or {}),
        "summary": {
            "total_datasets": len(dataset_records),
            "total_recipes": len(recipe_records),
            "recipe_types": dict(sorted(recipe_type_counter.items())),
            "recipes_with_sql": recipes_with_sql,
            "recipes_with_code": recipes_with_code,
            "recipes_with_join_logic": recipes_with_join_logic,
            "recipes_with_visual_logic": recipes_with_visual_logic,
            "total_lineage_edges": len(lineage["edges"]),
            "source_datasets": len(lineage["source_datasets"]),
            "intermediate_datasets": len(lineage["intermediate_datasets"]),
            "terminal_datasets": len(lineage["terminal_datasets"]),
            "isolated_datasets": len(lineage["isolated_datasets"]),
            "extraction_errors": len(errors)
        },
        "datasets": dataset_records,
        "recipes": recipe_records,
        "lineage": lineage,
        "errors": errors
    }

    # Versioned outputs plus a stable index pointing to the latest context.
    context_path = "{}_ARIS_PROJECT_CONTEXT_{}.json".format(
        project_key, timestamp
    )
    lineage_path = "{}_ARIS_LINEAGE_{}.json".format(
        project_key, timestamp
    )
    summary_path = "{}_ARIS_PROJECT_SUMMARY_{}.md".format(
        project_key, timestamp
    )
    index_path = "{}_ARIS_INDEX_latest.json".format(project_key)

    context_json = json.dumps(
        project_context,
        indent=JSON_INDENT,
        ensure_ascii=False,
        default=str
    )
    lineage_json = json.dumps(
        {
            "project_key": project_key,
            "generated_at_utc": generated_at_iso,
            "lineage": lineage
        },
        indent=JSON_INDENT,
        ensure_ascii=False,
        default=str
    )

    files = {
        "Project context": context_path,
        "Lineage": lineage_path,
        "Summary": summary_path,
        "Latest index": index_path
    }

    summary_markdown = create_summary_markdown(project_context, files)

    index = {
        "schema_version": "ARIS_INDEX_V1",
        "project_key": project_key,
        "managed_folder_id": FOLDER_ID,
        "generated_at_utc": generated_at_iso,
        "latest_context_file": context_path,
        "latest_lineage_file": lineage_path,
        "latest_summary_file": summary_path,
        "summary": project_context["summary"],
        "context_sha256": hashlib.sha256(
            context_json.encode("utf-8")
        ).hexdigest()
    }
    index_json = json.dumps(
        index,
        indent=JSON_INDENT,
        ensure_ascii=False,
        default=str
    )

    print("\nSaving ARIS context files...")
    upload_text(context_folder, context_path, context_json)
    upload_text(context_folder, lineage_path, lineage_json)
    upload_text(context_folder, summary_path, summary_markdown)
    upload_text(context_folder, index_path, index_json)

    print("\n" + "=" * 100)
    print("ARIS PROJECT ANALYSIS COMPLETE")
    print("=" * 100)
    print("Project key                :", project_key)
    print("Datasets                   :", len(dataset_records))
    print("Recipes                    :", len(recipe_records))
    print("Recipes with SQL           :", recipes_with_sql)
    print("Recipes with code          :", recipes_with_code)
    print("Recipes with join logic    :", recipes_with_join_logic)
    print("Recipes with visual logic  :", recipes_with_visual_logic)
    print("Lineage edges              :", len(lineage["edges"]))
    print("Extraction errors          :", len(errors))
    print("Managed folder ID          :", FOLDER_ID)
    print("Project context file       :", context_path)
    print("Lineage file               :", lineage_path)
    print("Summary file               :", summary_path)
    print("Latest index               :", index_path)
    print("Context size MB            :", round(
        len(context_json.encode("utf-8")) / (1024.0 * 1024.0), 2
    ))
    print("=" * 100)


if __name__ == "__main__":
    main()
